{
  // Cloudflare Workers (static assets + on-demand API routes) config.
  // Secrets (ADMIN_PASSWORD, later TURNSTILE_SECRET_KEY and RESEND_API_KEY)
  // are set with `wrangler secret put <NAME>`, never committed here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realai",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    // Leads, hero-agent sessions and events. Schema in migrations/.
    {
      "binding": "DB",
      "database_name": "realai-leads",
      "database_id": "e9d22428-da4e-46cd-9ad0-3fec4dce93eb",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    // Rate limiting for the lead and event endpoints. Auto-provisioned on first deploy.
    { "binding": "AGENT_KV" }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://realai.co.il"
  }
}
