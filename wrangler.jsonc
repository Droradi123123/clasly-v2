{
  // Cloudflare Workers (static assets + on-demand API routes) config.
  // Secrets (ADMIN_PASSWORD, GOOGLE_SA_KEY, GA4_PROPERTY_ID, later TURNSTILE_SECRET_KEY and RESEND_API_KEY)
  // are set with `wrangler secret put <NAME>`, never committed here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clasly-v2",
  // Astro handles requests; the cron below pulls Google Analytics and Search Console into D1 (src/lib/analytics.ts).
  // It ticks every 15 minutes but only pulls when the last pull is old enough (see maybeSyncAnalytics).
  "main": "./src/worker.ts",
  "triggers": { "crons": ["*/15 * * * *"] },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep variables added in the Cloudflare dashboard when deploying from this file.
  "keep_vars": true,
  "observability": { "enabled": true },
  "d1_databases": [
    // Leads, hero-agent sessions and events. Schema in migrations/.
    {
      "binding": "DB",
      "database_name": "realai-leads",
      "database_id": "e9d22428-da4e-46cd-9ad0-3fec4dce93eb",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    // Rate limiting for the lead and event endpoints. Auto-provisioned on first deploy.
    { "binding": "AGENT_KV" }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://realai.co.il"
  }
}
