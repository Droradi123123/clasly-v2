---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import GapSection from '@/components/GapSection.astro';
import MethodSection from '@/components/MethodSection.astro';
import ProofBlocks from '@/components/ProofBlocks.astro';
import OfferCards from '@/components/OfferCards.astro';
import CTA from '@/components/CTA.astro';
import FAQ from '@/components/FAQ.astro';
import { OFFERS, whatsappUrl } from '@/config/site';
import { serviceSchema, faqSchema } from '@/lib/seo';

const title = 'הרצאות וסדנאות AI לארגונים, מאנשים שהטמיעו AI';
const description = 'להטמיע AI בארגון זה קשה. אנחנו עשינו את זה בחברות טכנולוגיה מובילות עם אלפי עובדים. הרצאות, סדנאות, קורסים וליווי למנהלים, מהשטח ובעברית.';
const faq = [
  { q: 'מה אתם מעבירים בדיוק?', a: 'הרצאות, סדנאות מעשיות, קורסים והכשרות, וליווי אישי למנהלים. כל תוכנית נבנית סביב הארגון: הקהל, האתגר והקצב. הכול בעברית, לארגונים בישראל, פרונטלי או Zoom.' },
  { q: 'במה אתם שונים ממרצי AI אחרים?', a: 'לא למדנו AI מסרטונים. הטמענו אותו בעצמנו בחברות טכנולוגיה מובילות עם אלפי עובדים: אסטרטגיה ארגונית, סוכנים ואוטומציות בפרודקשן, אבטחת מידע, ניטור ומדידת ROI. כל דוגמה בכיתה היא משהו שעשינו בידיים.' },
  { q: 'איך מתחילים להטמיע AI בארגון?', a: 'לא מכלי ולא מרישיונות. מתחילים מאנשים: סביבה בטוחה עם הרשאות קריאה בלבד, מסר ברור שמותר לטעות, ושגרירים בכל צוות שמפיצים את השימוש מבפנים. רק כשאנשים משתמשים, עוברים לבנייה מהירה של הרבה מקרי שימוש קטנים, ומשם לבנייה מחדש של תחום שלם.' },
  { q: 'למה רוב הטמעות ה-AI נכשלות?', a: 'כי ניגשים אליהן כמו לפרויקט טכנולוגי. המחסום האמיתי הוא אנושי: אנשים חוששים לטעות, לא בטוחים מה מותר, ולא רואים איך הכלי מתחבר לעבודה שלהם. ובנוסף, רוב התהליכים לא מתועדים, ואי אפשר לבנות מחדש תהליך שאף אחד לא יודע לתאר.' },
  { q: 'למי זה מתאים?', a: 'לאוניברסיטאות ומכללות (תוכניות יזמות, לימודי המשך, פקולטות), לחברות וצוותים (HR, תפעול, שירות, פיתוח, הנהלה) ולמנהלים שרוצים להוביל AI בארגון ולא רק לדבר עליו.' },
  { q: 'אילו נושאים אתם מכסים?', a: 'הטמעת AI בארגון, Claude Code, n8n ואוטומציה, סוכני AI, בניית מוצרים עם AI, ROI של AI ו-AI למנהלים. כל נושא זמין כהרצאה, סדנה, קורס או ליווי.' },
  { q: 'האם צריך רקע טכני?', a: 'לא. רוב הקהלים שלנו אינם טכניים. בסדנאות גם מי שלא כתב שורת קוד בונה אוטומציה או כלי שעובד. לקהל טכני יש מסלולים מעמיקים.' },
  { q: 'איך מתחילים?', a: 'כותבים לנו בוואטסאפ או בטופס מה הארגון צריך. תוך יום עסקים חוזרים אליכם, ואחרי שיחת היכרות קצרה בונים יחד את התוכנית.' },
];
const schema = [...OFFERS.map((o) => serviceSchema({ name: `${o.name} AI`, description: o.value, path: o.href, serviceType: o.name, audience: o.audience })), faqSchema(faq)];
const wa = whatsappUrl('שלום, אשמח לדבר על הטמעת AI בארגון שלנו.');
---
<BaseLayout title={title} description={description} path="/" schema={schema}>
  <section class="hero">
    <div class="aurora aurora-a" aria-hidden="true"></div>
    <div class="aurora aurora-b" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container-x relative pb-16 pt-14 md:pb-24 md:pt-24">
      <div class="mx-auto max-w-5xl text-center">
        <p class="pill rise"><span class="dot" aria-hidden="true"></span>הרצאות · סדנאות · קורסים · ליווי למנהלים</p>
        <h1 class="display mt-8">
          <span class="rise block" style="animation-delay:.1s">להטמיע AI בארגון</span>
          <span class="rise block" style="animation-delay:.25s">זה <span class="scribble">קשה<svg viewBox="0 0 200 22" preserveAspectRatio="none" aria-hidden="true"><path d="M196 13 C 160 4, 128 20, 92 11 S 34 6, 4 14" /></svg></span>.</span>
          <span class="rise text-gradient block pt-2" style="animation-delay:.85s">אנחנו עשינו את זה.</span>
        </h1>
        <p class="lead rise mx-auto mt-8 max-w-2xl" style="animation-delay:1s">לא למדנו AI מסרטונים. הטמענו אותו בעצמנו, בחברות טכנולוגיה מובילות עם אלפי עובדים: מהאסטרטגיה, דרך סוכנים שרצים בפרודקשן, ועד הרגע שבו אנשים באמת משתמשים בזה כל יום. עכשיו אנחנו מלמדים את מה שלמדנו בדרך הקשה.</p>
        <div class="rise mt-10 flex flex-wrap justify-center gap-3" style="animation-delay:1.1s">
          <a href={wa} class="btn btn-primary" target="_blank" rel="noopener" data-track="whatsapp_click" data-track-label="hero">בואו נדבר</a>
          <a href="#offers-title" class="btn btn-ghost">איך עובדים איתנו</a>
        </div>
      </div>
    </div>
  </section>

  <LogoStrip />
  <GapSection />
  <MethodSection />
  <ProofBlocks />
  <!-- Testimonials: hidden until genuine quotes are collected (see TODO.md). Never use invented quotes. -->
  <OfferCards />
  <FAQ items={faq} title="שאלות שארגונים שואלים אותנו" />

  <CTA title="בואו נדבר על הארגון שלכם" text="ספרו לנו איפה אתם עומדים עם AI ומה תקוע. נחזור תוך יום עסקים עם כיוון ראשון." whatsappMessage="שלום, אשמח לדבר על הטמעת AI בארגון שלנו." trackLabel="home" />
</BaseLayout>
