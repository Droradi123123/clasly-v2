---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import GapSection from '@/components/GapSection.astro';
import ProofBlocks from '@/components/ProofBlocks.astro';
import OfferCards from '@/components/OfferCards.astro';
import TopicLinks from '@/components/TopicLinks.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import CTA from '@/components/CTA.astro';
import FAQ from '@/components/FAQ.astro';
import { OFFERS } from '@/config/site';
import { serviceSchema, faqSchema } from '@/lib/seo';

const title = 'הרצאות וסדנאות AI לארגונים, מאנשים שהטמיעו AI';
const description = 'לומדים AI מאנשים שבנו מאות אייג׳נטים מתוך ארגונים של אלפי עובדים: הרצאות, סדנאות וקורסים לחברות, לאקדמיה ולמנהלים, בעברית.';
const faq = [
  { q: 'מה אתם מעבירים בדיוק?', a: 'הרצאות, סדנאות מעשיות, קורסים והכשרות, וליווי אישי למנהלים. כל תוכנית נבנית סביב הארגון: הקהל, האתגר והקצב. הכול בעברית, לארגונים בישראל, פרונטלי או Zoom.' },
  { q: 'במה אתם שונים ממרצי AI אחרים?', a: 'לא למדנו AI מסרטונים. הטמענו אותו בעצמנו בחברות טכנולוגיה מובילות עם אלפי עובדים: אסטרטגיה ארגונית, סוכנים ואוטומציות בפרודקשן, אבטחת מידע, ניטור ומדידת ROI. כל דוגמה בכיתה היא משהו שעשינו בידיים.' },
  { q: 'כמה זה עולה?', a: 'המחיר תלוי בפורמט, באורך, בגודל הקבוצה וברמת ההתאמה לארגון. אחרי שיחת היכרות קצרה שולחים סילבוס והצעת מחיר מסודרת תוך יום עסקים.' },
  { q: 'זה בעברית? אפשר ב-Zoom?', a: 'כן לשניהם. הכול מועבר בעברית, עם שמות הכלים באנגלית. אפשר פרונטלי בארגון, בכנס או בקמפוס, ב-Zoom, או במשולב.' },
  { q: 'למי זה מתאים?', a: 'לאוניברסיטאות ומכללות (תוכניות יזמות, לימודי המשך, פקולטות), לחברות וצוותים (HR, תפעול, שירות, פיתוח, הנהלה) ולמנהלים שרוצים להוביל AI בארגון ולא רק לדבר עליו.' },
  { q: 'אילו נושאים אתם מכסים?', a: 'Claude Code, סוכני AI, n8n ואוטומציה, בניית מוצרים עם AI, AI למנהלים, ROI של AI והטמעת AI בארגון. כל נושא זמין כהרצאה, סדנה, קורס או ליווי.' },
  { q: 'האם צריך רקע טכני?', a: 'לא. רוב הקהלים שלנו אינם טכניים. בסדנאות גם מי שלא כתב שורת קוד בונה אוטומציה או כלי שעובד. לקהל טכני יש מסלולים מעמיקים.' },
  { q: 'איך מתחילים?', a: 'כותבים לנו בוואטסאפ או בטופס מה הארגון צריך. תוך יום עסקים חוזרים אליכם, ואחרי שיחת היכרות קצרה בונים יחד את התוכנית.' },
];
const schema = [...OFFERS.map((o) => serviceSchema({ name: `${o.name} AI`, description: o.value, path: o.href, serviceType: o.name, audience: o.audience })), faqSchema(faq)];
---
<BaseLayout title={title} description={description} path="/" schema={schema}>
  <section class="hero">
    <div class="container-x pb-14 pt-12 md:pb-20 md:pt-20">
      <nav aria-label="למי זה מתאים">
        <ul class="audience-list" role="list">
          <li><a href="/companies">לחברות</a></li>
          <li><a href="/academia">לאוניברסיטאות ומכללות</a></li>
          <li><a href="/executive">למנהלים</a></li>
        </ul>
      </nav>
      <h1 class="display mt-7 text-balance">
        <span class="block">לומדים AI מאנשים שבנו מאות אייג׳נטים</span>
        <span class="block text-accent">מתוך ארגונים של אלפי עובדים.</span>
      </h1>
      <p class="lead mt-8 max-w-3xl">הרצאות, סדנאות וקורסים על AI לחברות, לאקדמיה ולמנהלים. לא למדנו AI מסרטונים: אנחנו בונים איתו כל יום, ומלמדים מתוך מה שעובד ומה שנשבר.</p>
      <div class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <a href="/program" class="btn btn-primary" data-track="cta_click" data-track-label="hero">בואו נבנה לכם תוכנית המתאימה לצרכים שלכם</a>
        <a href="#offers-title" class="btn btn-ghost">מה אנחנו מעבירים?</a>
      </div>
    </div>
  </section>

  <LogoStrip />
  <OfferCards />
  <TopicLinks />
  <ProofBlocks />
  <GapSection />
  <HowItWorks title="איך עובדים איתנו" />
  <RelatedArticles title="מהבלוג: מדריכים מהשטח" slugs={['claude-code-for-non-developers', 'n8n-ai-agent', 'hours-saved-is-not-an-ai-strategy']} limit={3} moreHref="/blog" />
  <!-- Testimonials: hidden until genuine quotes are collected (see TODO.md). Never use invented quotes. -->
  <FAQ items={faq} title="שאלות שארגונים שואלים אותנו" />

  <CTA title="בואו נדבר על הארגון שלכם" text="ספרו לנו איפה אתם עומדים עם AI ומה תקוע. נחזור תוך יום עסקים עם כיוון ראשון." whatsappMessage="שלום, אשמח לדבר על הטמעת AI בארגון שלנו." trackLabel="home" />
</BaseLayout>
