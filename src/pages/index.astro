---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import GapSection from '@/components/GapSection.astro';
import ProofBlocks from '@/components/ProofBlocks.astro';
import TopicsSection from '@/components/TopicsSection.astro';
import BridgeSection from '@/components/BridgeSection.astro';
import CTA from '@/components/CTA.astro';
import FAQ from '@/components/FAQ.astro';
import { OFFERS } from '@/config/site';
import { serviceSchema, faqSchema } from '@/lib/seo';

const title = 'הרצאות וסדנאות AI לארגונים, ממי שעשה את זה קודם';
const description = 'הרצאות, סדנאות וקורסים על AI: Claude Code, סוכני AI, n8n, בניית מוצרים ו-AI למנהלים. מצוות שבנה מאות אייג׳נטים והטמיע AI בארגונים של אלפי עובדים. בעברית.';
const faq = [
  { q: 'מה אתם מעבירים בדיוק?', a: 'הרצאות, סדנאות מעשיות, קורסים והכשרות, וליווי אישי למנהלים. הנושאים: Claude Code, סוכני AI, n8n ואוטומציה, בניית מוצרים עם AI, AI למנהלים, ROI של AI והטמעת AI בארגון. כל תוכנית נבנית סביב הארגון: הקהל, האתגר והקצב. הכול בעברית, פרונטלי או Zoom.' },
  { q: 'במה אתם שונים ממרצי AI אחרים?', a: 'כל מה שאנחנו מלמדים, עשינו קודם ואנחנו עושים גם היום. בנינו מאות אייג׳נטים, חלקם בפרודקשן מול לקוחות, והובלנו הטמעת AI בחברות טכנולוגיה עם אלפי עובדים. כל דוגמה בכיתה היא משהו שבנינו בידיים, לא סיכום של סרטון.' },
  { q: 'מי מעביר את ההרצאות והסדנאות?', a: 'אנשים שעובדים היום בתעשייה ובונים עם הכלים האלה כל יום. זה תנאי סף אצלנו, כדי שהדוגמאות בכיתה יהיו מהחודש האחרון ולא משנה שעברה.' },
  { q: 'למי זה מתאים?', a: 'לאוניברסיטאות ומכללות (תוכניות יזמות, לימודי המשך, פקולטות), לחברות וצוותים (HR, תפעול, שירות, פיתוח, הנהלה) ולמנהלים שרוצים להוביל AI בארגון ולא רק לדבר עליו.' },
  { q: 'האם צריך רקע טכני?', a: 'לא. רוב הקהלים שלנו אינם טכניים. בסדנאות גם מי שלא כתב שורת קוד בונה אוטומציה או כלי שעובד. לקהל טכני יש מסלולים מעמיקים.' },
  { q: 'עם מה יוצאים מסדנה או מקורס?', a: 'עם משהו שעובד: אוטומציה, סוכן או מוצר קטן שנבנה על תהליך אמיתי מהארגון, ועם צעדים לשבוע הקרוב. לא עם מצגת.' },
  { q: 'איך מתחילים להטמיע AI בארגון?', a: 'מאנשים, לא מכלים: סביבה בטוחה, מסר ברור שמותר לטעות, ושגרירים בכל צוות. רק אחר כך בונים הרבה מקרי שימוש קטנים. זה נושא שאנחנו מלמדים, ויש עליו מדריך מלא באתר.' },
  { q: 'איך מתחילים לעבוד איתכם?', a: 'כותבים לנו בוואטסאפ או בטופס מה הארגון צריך. תוך יום עסקים חוזרים אליכם, ואחרי שיחת היכרות קצרה בונים יחד את התוכנית.' },
];
const schema = [...OFFERS.map((o) => serviceSchema({ name: `${o.name} AI`, description: o.value, path: o.href, serviceType: o.name, audience: o.audience })), faqSchema(faq)];
---
<BaseLayout title={title} description={description} path="/" schema={schema}>
  <section class="hero">
    <div class="container-x pb-6 pt-12 md:pb-10 md:pt-20">
      <nav aria-label="למי זה מתאים">
        <ul class="audience-list" role="list">
          <li><a href="/companies">לחברות</a></li>
          <li><a href="/academia">לאוניברסיטאות ומכללות</a></li>
          <li><a href="/executive">למנהלים</a></li>
        </ul>
      </nav>
      <h1 class="display mt-7 max-w-5xl text-balance">
        <span class="block">כל מה שאנחנו מלמדים,</span>
        <span class="block text-accent">עשינו קודם.</span>
      </h1>
      <p class="lead mt-7 max-w-3xl">הרצאות, סדנאות וקורסים על AI: Claude Code, סוכני AI, n8n ואוטומציה, בניית מוצרים ו-AI למנהלים. מצוות ש<strong class="text-fg">בנה מאות אייג׳נטים</strong> ו<strong class="text-fg">הטמיע AI בארגונים של אלפי עובדים</strong>, ומלמד מתוך זה.</p>
      <div class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <a href="/program" class="btn btn-primary" data-track="cta_click" data-track-label="hero">בואו נבנה לכם תוכנית המתאימה לצרכים שלכם</a>
        <a href="#offers-title" class="btn btn-ghost">מה אנחנו מעבירים?</a>
      </div>
    </div>
    <BridgeSection />
  </section>

  <LogoStrip />
  <TopicsSection />
  <GapSection />
  <ProofBlocks />
  <!-- Testimonials: hidden until genuine quotes are collected (see TODO.md). Never use invented quotes. -->
  <FAQ items={faq} title="שאלות שארגונים שואלים אותנו" />

  <CTA title="בואו נדבר על הארגון שלכם" text="ספרו לנו איפה אתם עומדים עם AI ומה תקוע. נחזור תוך יום עסקים עם כיוון ראשון." whatsappMessage="שלום, אשמח לדבר על הטמעת AI בארגון שלנו." trackLabel="home" />
</BaseLayout>
