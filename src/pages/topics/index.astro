---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { TOPICS } from '@/config/site';
import { breadcrumbSchema, collectionPageSchema } from '@/lib/seo';
const posts = await getCollection('blog', ({ data }) => !data.draft);
const crumbs = [{ name: 'דף הבית', path: '/' }, { name: 'נושאים', path: '/topics' }];
const hubs = await getCollection('hubs');
const description = 'מרכזי הידע שלנו לפי נושא: Claude Code, n8n ואוטומציה, סוכני AI, הטמעת AI בארגון, בניית מוצרים עם AI, ROI של AI ו-AI למנהלים.';
const schema = [breadcrumbSchema(crumbs), collectionPageSchema({ name: 'נושאים', description, path: '/topics', items: TOPICS.map((t) => ({ name: t.name, path: `/topics/${t.slug}` })) })];
---
<BaseLayout title="נושאים: Claude Code, n8n, סוכני AI והטמעת AI" description={description} path="/topics" schema={schema}>
  <section class="container-x py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <h1 class="h1 mt-6">נושאים</h1>
    <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {TOPICS.map((t) => { const n = posts.filter((p) => p.data.topicHub === t.slug).length; const hub = hubs.find((h) => h.data.slug === t.slug); return (
        <li class="card reveal p-6"><h2 class="h3"><a href={`/topics/${t.slug}`} class="hover:text-accent">{t.name}</a></h2>{hub && <p class="mt-2 text-sm text-muted">{hub.data.description}</p>}<p class="mt-3 text-xs text-accent">{n} מאמרים</p></li>
      ); })}
    </ul>
  </section>
</BaseLayout>
