---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import { getCollection, render } from 'astro:content';
import { TOPICS, OFFERS } from '@/config/site';
import { breadcrumbSchema, faqSchema, howToSchema, collectionPageSchema } from '@/lib/seo';

export async function getStaticPaths() {
  const hubs = await getCollection('hubs');
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return TOPICS.map((t) => ({
    params: { topic: t.slug },
    props: { topic: t, hub: hubs.find((h) => h.data.slug === t.slug) ?? null, posts: posts.filter((p) => p.data.topicHub === t.slug).sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime()) },
  }));
}
const { topic, hub, posts } = Astro.props;
const path = `/topics/${topic.slug}`;
const crumbs = [{ name: 'דף הבית', path: '/' }, { name: 'נושאים', path: '/topics' }, { name: topic.name, path }];
const Content = hub ? (await render(hub)).Content : null;
const title = hub?.data.title ?? `${topic.name}: מדריכים והרצאות לארגונים`;
const description = hub?.data.description ?? `כל המאמרים שלנו בנושא ${topic.name}, עם קישור להרצאות, סדנאות וקורסים בנושא. נכתב על ידי צוות שמטמיע AI בתעשייה.`;
const h1 = hub?.data.h1 ?? `${topic.name}: מה למדנו מהשטח`;
const relatedOffer = hub?.data.relatedOffer ?? '/workshops';
const offer = OFFERS.find((o) => o.href === relatedOffer)!;
const schema: object[] = [breadcrumbSchema(crumbs), collectionPageSchema({ name: h1, description, path, items: posts.map((p) => ({ name: p.data.title, path: `/blog/${p.data.slug}` })) })];
if (hub) schema.push(faqSchema(hub.data.faq));
if (hub?.data.howTo) schema.push(howToSchema({ ...hub.data.howTo, path }));
const iso = hub ? hub.data.updatedAt.toISOString().slice(0, 10) : null;
---
<BaseLayout title={title} description={description} path={path} schema={schema} updatedAt={iso ?? undefined}>
  <section class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container-x relative py-12 md:py-16">
      <Breadcrumbs items={crumbs} />
      <h1 class="h1 mt-6 max-w-4xl">{h1}</h1>
      <p class="lead mt-5 max-w-3xl">{description}</p>
      {iso && <p class="mt-3 text-sm text-muted">עודכן לאחרונה: <time datetime={iso}>{hub!.data.updatedAt.toLocaleDateString('he-IL', { year: 'numeric', month: 'long', day: 'numeric' })}</time></p>}
    </div>
  </section>
  {Content && <div class="container-x prose pb-8"><Content /></div>}
  <section class="container-x py-10" aria-labelledby="articles-title">
    <h2 id="articles-title" class="h2">מאמרים בנושא {topic.name}</h2>
    {posts.length === 0 ? <p class="mt-4 text-muted">מאמרים בנושא הזה בדרך. בינתיים, <a class="text-accent underline" href="/blog">לבלוג</a>.</p> : (
      <ul class="mt-6 grid gap-5 md:grid-cols-2">
        {posts.map((p) => <li class="card reveal p-6"><h3 class="h3"><a href={`/blog/${p.data.slug}`} class="hover:text-accent">{p.data.title}</a></h3><p class="mt-2 text-sm text-muted">{p.data.description}</p></li>)}
      </ul>
    )}
  </section>
  {hub && <FAQ items={hub.data.faq} />}
  <CTA title={`רוצים ${offer.name} בנושא ${topic.name}?`} text={offer.value} whatsappMessage={`שלום, אשמח לשמוע על ${offer.name} בנושא ${topic.name} לארגון שלנו.`} audienceType={offer.audienceType} topic={topic.name} trackLabel={`topic:${topic.slug}`} />
</BaseLayout>
