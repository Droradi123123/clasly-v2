---
import PageLayout from '@/layouts/PageLayout.astro';
import CTA from '@/components/CTA.astro';
import { PROGRAM_NAMES } from '@/config/site';
import { faqSchema } from '@/lib/seo';
const path = '/how-this-site-was-built';
const faq = [
  { q: 'כמה זמן לקח לבנות את האתר?', a: 'השלד, העיצוב, מערכת הלידים ועשרות המאמרים הראשונים נבנו בשני סשנים של עבודה עם Claude Code, על בסיס מפרט שנכתב מראש. מאז אנחנו ממשיכים לתקן ולהוסיף תוכן.' },
  { q: 'מה הכלים?', a: 'Claude Code כסוכן הבנייה הראשי, Astro ו-Tailwind לאתר, Cloudflare Workers לאחסון ול-API, Cloudflare D1 למסד הנתונים.' },
  { q: 'האם מישהו לא טכני יכול לבנות ככה?', a: 'כן, זה בדיוק מה שאנחנו מלמדים בסדנת Claude Code. התנאי הוא לדעת לכתוב מפרט טוב, לפרק משימות ולבדוק תוצאות. את זה לומדים ביום אחד.' },
  { q: 'אפשר ללמוד את זה בארגון שלנו?', a: 'כן. יום Claude Code הוא סדנה של יום אחד שבה כל משתתף בונה אתר או כלי משלו, באותה שיטה.' },
];
---
<PageLayout title="איך נבנה האתר הזה עם Claude Code וסוכני AI" description="האתר הזה נבנה עם Claude Code: מפרט, סוכן בנייה, Astro ו-Cloudflare. ככה עשינו את זה, צעד אחרי צעד, ואיך תלמדו לבנות ככה בעצמכם." path={path} h1="האתר הזה נבנה עם סוכני AI. ככה." lead="לא קנינו תבנית ולא שכרנו סטודיו. כתבנו מפרט של כמה עמודים, נתנו אותו ל-Claude Code, ועבדנו איתו כמו עם מפתח בכיר: משימה, בדיקה, תיקון. זה אותו תהליך שאנחנו מלמדים בסדנאות." schema={[faqSchema(faq)]} updatedAt="2026-10-24">
  <h2>שלב 1: מפרט לפני קוד</h2>
  <p>הדבר הכי חשוב קרה לפני שורת הקוד הראשונה. כתבנו מסמך דרישות: מה האתר מוכר, למי, איך נראה דף הבית, אילו עמודים יש, מה ה-SEO צריך לעשות, ואיזה "רגע וואו" מותר (אחד בכל נקודת מגע, לא יותר). המסמך כלל גם את מה שאסור: בלי שמות אנשים, בלי קרוסלות, בלי סופרלטיבים.</p>
  <div class="definition"><strong>הכלל שלנו:</strong> סוכן קוד טוב בדיוק כמו המפרט שהוא מקבל. שעה על המפרט חוסכת יום של תיקונים.</div>
  <h2>שלב 2: סוכן בנייה אחד, משימות קטנות</h2>
  <p>Claude Code קיבל את המפרט ועבד בשלבים: שלד הפרויקט (Astro, Tailwind), מערכת עיצוב, דף הבית, עמודי ההצעות, תשתית SEO, מסד נתונים ואז התוכן. אחרי כל שלב: בנייה, בדיקה, תיקון. כשמשהו לא עבד (למשל גרסת Node לא נתמכת), הסוכן מצא פתרון ותיעד אותו.</p>
  <h2>שלב 3: לידים בלי עוד שירות לנהל</h2>
  <p>כל פנייה מהאתר נשמרת במסד נתונים של Cloudflare (D1), באותו חשבון שבו האתר רץ. אין שרת נוסף, אין מפתח שצריך להעתיק, והמסד זמין רק לשרת של האתר. יש הגבלת קצב לפי כתובת IP, הגנה מספאם, ודף פנימי מוגן שבו רואים כל ליד ומעדכנים סטטוס: חדש, נוצר קשר, נשלחה הצעה, נסגר. ואם השמירה נכשלת, המבקר לא רואה "תודה" ריקה אלא הפנייה לוואטסאפ.</p>
  <h2>שלב 4: SEO ו-GEO מובנים, לא מודבקים</h2>
  <p>כל עמוד נוצר סטטית עם כותרת ייחודית, תיאור, קנוני, Open Graph, תמונת שיתוף שנוצרת אוטומטית, ו-JSON-LD (ארגון, שירות, קורס, שאלות נפוצות, פירורי לחם). יש sitemap, robots.txt שמאפשר במפורש למנועי AI לסרוק, וקובץ llms.txt שמסביר למודלים מי אנחנו. כל מאמר בבלוג נכתב בשיטת "תשובה קודם": הפסקה הראשונה עונה על השאלה, כדי שמנוע חיפוש או מודל יוכלו לצטט אותה.</p>
  <h2>שלב 5: מנוע תוכן</h2>
  <p>המאמרים הם קובצי MDX עם מטא-דאטה (ביטוי מפתח, נושא, הצעה קשורה, שאלות נפוצות). סקריפט אחד יוצר טיוטה למאמר חדש מביטוי מפתח, וסקריפט שני בודק כל מאמר: ביטוי המפתח בכותרת ובפסקה הראשונה, אורך, קישורים פנימיים, שאלות נפוצות, ובלי שמות אנשים.</p>
  <h2>מה למדנו</h2>
  <ul>
    <li><strong>המפרט הוא המוצר.</strong> רוב השיפורים היו שינוי במילים, לא בקוד.</li>
    <li><strong>לבדוק מוקדם.</strong> בנייה אחרי כל שלב חוסכת שעות.</li>
    <li><strong>להחליט ולתעד.</strong> כל החלטה שלא הייתה במפרט נרשמה בקובץ DECISIONS.md, כדי שאפשר יהיה להבין אותה אחר כך.</li>
    <li><strong>אפשר ללמד את זה.</strong> אין פה קסם. יש שיטה, ואותה אנחנו מעבירים ביום אחד.</li>
  </ul>
  <h2>שאלות נפוצות</h2>
  {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
  <Fragment slot="after">
    <CTA title={`רוצים לבנות ככה? ${PROGRAM_NAMES.claudeCodeDay}`} text="סדנה של יום אחד שבה כל משתתף בונה אתר, כלי או אוטומציה עם Claude Code. גם בלי רקע בתכנות." whatsappMessage="שלום, קראתי איך נבנה האתר ואשמח לשמוע על סדנת Claude Code לצוות שלנו." audienceType="company" topic="Claude Code" trackLabel="how-built" />
  </Fragment>
</PageLayout>
