---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { relatedMap } from '@/lib/related';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const related = relatedMap(posts);
  return posts.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, related: related.get(entry.id) ?? [] } }));
}
const { entry, related } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
// Reading time from the MDX body: Hebrew prose reads at roughly 200 words a minute.
const words = (entry.body ?? '').replace(/<[^>]+>/g, ' ').replace(/[#*_>|`\[\]()-]/g, ' ').split(/\s+/).filter(Boolean).length;
---
<ArticleLayout entry={entry} related={related} toc={toc} words={words}><Content /></ArticleLayout>
