---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import ProofBlocks from '@/components/ProofBlocks.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/seo';
const path = '/companies';
const title = 'הכשרת AI לארגונים | הדרכת בינה מלאכותית לעובדים';
const description = 'הכשרת AI לארגונים וחברות: הרצאות לכל העובדים, סדנאות מעשיות וקורסים לצוותים. מצוות שהטמיע AI בארגונים של אלפי עובדים, עם ROI נמדד.';
const crumbs = [{ name: 'דף הבית', path: '/' }, { name: 'לחברות', path }];
const faq = [
  { q: 'אתם מלמדים רק כלים, או גם איך להוביל AI בארגון?', a: 'גם וגם. מעבר לכלים, אנחנו מלמדים איך מגדירים אסטרטגיית AI, איך בונים תוכנית עבודה ומחליטים מה לבנות קודם, ואיך מניעים ארגון שלם להשתמש ב-AI. את כל אלה עשינו בעצמנו בארגונים של אלפי עובדים.' },
  { q: 'מאיפה מתחילים הכשרת AI בארגון?', a: 'בדרך כלל בהרצאה לכל הארגון שמיישרת קו, ואחריה סדנה לצוות אחד על תהליך אמיתי. אחרי הצלחה מדידה אחת, מרחיבים.' },
  { q: 'האם זה מתאים לצוותים לא טכניים?', a: 'כן. רוב הסדנאות שלנו מיועדות לצוותי תפעול, שיווק, מכירות, שירות ו-HR. בונים אוטומציות עם n8n, בלי לכתוב קוד.' },
  { q: 'איך מודדים הצלחה?', a: 'לפני הסדנה מגדירים תהליך ומדד (זמן, פניות, טעויות). בסוף הסדנה יש אוטומציה שרצה ומספר שאפשר להציג.' },
  { q: 'מה עם אבטחת מידע?', a: 'אנחנו עובדים עם הכלים והמדיניות של הארגון. בסדנאות לא מעלים נתונים רגישים, ומלמדים איך לעבוד עם מודלי שפה בצורה בטוחה.' },
  { q: 'כמה אנשים אפשר להכשיר?', a: 'הרצאה: ללא הגבלה. סדנה: 8 עד 25. קורס: 10 עד 30. למחלקות גדולות בונים סדרת מפגשים.' },
];
const schema = [breadcrumbSchema(crumbs), faqSchema(faq), serviceSchema({ name: 'הכשרת AI לארגונים', description, path, serviceType: 'Corporate AI training', audience: 'Companies in Israel' })];
const paths = [
  { who: 'HR ו-L&D', what: 'הרצאה לכל הארגון וסדנת "AI בעבודה" לצוותים', href: '/lectures' },
  { who: 'תפעול, שירות, מכירות', what: 'סדנת n8n: אוטומציה על תהליך אמיתי תוך יום', href: '/workshops' },
  { who: 'פיתוח ומוצר', what: 'יום Claude Code או בוטקמפ סוכני AI', href: '/courses' },
  { who: 'הנהלה', what: 'ליווי אישי: אסטרטגיית AI ותוכנית לרבעון', href: '/executive' },
];
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <section class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container-x relative py-12 md:py-20">
      <Breadcrumbs items={crumbs} />
      <h1 class="h1 mt-6 max-w-4xl">הכשרת AI לארגונים שרוצים תוצאות, לא מצגות</h1>
      <p class="lead mt-5 max-w-3xl">הרצאות, סדנאות וקורסי AI לחברות ולצוותים, מאנשים שבנו אסטרטגיית AI, סוכנים ואוטומציות בפרודקשן. כל מפגש מסתיים במשהו שעובד ובמספר שאפשר להציג.</p>
      <div class="mt-8 flex flex-wrap gap-3"><a href="/program" class="btn btn-primary" data-track="cta_click" data-track-label="companies">בואו נבנה לכם תוכנית המתאימה לצרכים שלכם</a><a href="/workshops" class="btn btn-ghost">לסדנאות</a></div>
    </div>
  </section>
  <section class="py-14"><div class="container-x">
    <h2 class="h2">מסלול לפי צוות</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {paths.map((p) => <a href={p.href} class="card reveal flex items-start justify-between gap-4 p-6 hover:border-accent"><div><p class="text-sm text-muted">{p.who}</p><p class="mt-1 text-lg font-bold">{p.what}</p></div><span class="text-accent">←</span></a>)}
    </div>
  </div></section>

  <section class="border-t border-line py-20 md:py-24" aria-labelledby="beyond-title">
    <div class="container-x">
      <p class="eyebrow">מעבר לכלים</p>
      <h2 id="beyond-title" class="h2 mt-3 max-w-3xl">מה ארגון לומד איתנו, חוץ מלהשתמש בכלים</h2>
      <p class="lead mt-4 max-w-3xl">כלים לומדים ביום. מה שקובע אם AI יעבוד אצלכם הוא כל מה שמסביב. את זה עשינו בעצמנו בארגונים של אלפי עובדים, ואת זה אנחנו מעבירים.</p>
      <ol class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        <li class="rule-top"><h3 class="text-lg font-bold">אסטרטגיית AI</h3><p class="mt-2 text-muted">מה הארגון רוצה להשיג, איפה AI באמת עוזר ואיפה לא, ואיך זה מתחבר ליעדים העסקיים.</p></li>
        <li class="rule-top"><h3 class="text-lg font-bold">תוכנית עבודה</h3><p class="mt-2 text-muted">איך מחליטים מה לבנות קודם: ערך מול מאמץ, נתונים זמינים, סיכון, ומי הבעלים של כל יוזמה.</p></li>
        <li class="rule-top"><h3 class="text-lg font-bold">להניע ארגון שלם</h3><p class="mt-2 text-muted">סביבה בטוחה להתנסות, שגרירים בכל צוות ומסר ברור מההנהלה, כדי שאנשים ישתמשו ב-AI כל יום ולא רק בשבוע הראשון.</p></li>
        <li class="rule-top"><h3 class="text-lg font-bold">יכולות לכל צוות</h3><p class="mt-2 text-muted">כל צוות לומד לבנות את מה שרלוונטי לו: אוטומציות לתפעול ולשירות, סוכנים לפיתוח, כלים להנהלה.</p></li>
        <li class="rule-top"><h3 class="text-lg font-bold">אבטחה ומדיניות</h3><p class="mt-2 text-muted">איך עובדים עם מודלי שפה בצורה בטוחה, ואיך עוברים אבטחת מידע, משפטית ורכש בלי לאבד חודשים.</p></li>
        <li class="rule-top"><h3 class="text-lg font-bold">מדידה</h3><p class="mt-2 text-muted">איך מודדים ROI של AI בצורה שההנהלה מוכנה לחתום עליה, ולא רק סופרים שעות שנחסכו.</p></li>
      </ol>
    </div>
  </section>
  <ProofBlocks />
  <!-- Testimonials for companies: hidden until genuine quotes are collected (TODO.md). -->
  <FAQ items={faq} />
  <RelatedArticles slugs={['ai-course-for-employees-sample-syllabus', 'measuring-ai-training-success', 'ai-lecture-for-employees-what-to-include', 'why-employees-dont-use-ai-tools', 'ai-workshop-for-hr-teams', 'ai-adoption-90-day-plan']} />
  <CTA whatsappMessage="שלום, אני מחברה ואשמח לשמוע על הכשרת AI לצוות שלנו." audienceType="company" topic="חברות" trackLabel="companies" title="בואו נבנה תוכנית AI לצוות שלכם" />
</BaseLayout>
