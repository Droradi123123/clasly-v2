---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import ProofBlocks from '@/components/ProofBlocks.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/seo';
const path = '/companies';
const title = 'הכשרת AI לארגונים | הדרכת בינה מלאכותית לעובדים';
const description = 'הכשרת AI לארגונים וחברות: הרצאות לכל העובדים, סדנאות מעשיות וקורסים לצוותים. מצוות שהטמיע AI בארגונים של אלפי עובדים, עם ROI נמדד.';
const crumbs = [{ name: 'דף הבית', path: '/' }, { name: 'לחברות', path }];
const faq = [
  { q: 'מאיפה מתחילים הכשרת AI בארגון?', a: 'בדרך כלל מהרצאה לכל הארגון שמיישרת קו, ואז סדנה לצוות אחד עם תהליך אמיתי. אחרי שיש הצלחה אחת מדידה, מרחיבים.' },
  { q: 'האם זה מתאים לצוותים לא טכניים?', a: 'כן. רוב הסדנאות שלנו הן לצוותי תפעול, שיווק, מכירות, שירות ו-HR. בונים אוטומציות עם n8n בלי קוד.' },
  { q: 'איך מודדים הצלחה?', a: 'לפני הסדנה מגדירים תהליך ומדד (זמן, פניות, טעויות). אחרי הסדנה יש אוטומציה שרצה ומספר שאפשר להציג.' },
  { q: 'מה עם אבטחת מידע?', a: 'אנחנו עובדים עם הכלים והמדיניות של הארגון. בסדנאות לא מעלים נתונים רגישים, ומסבירים איך לעבוד נכון עם מודלים בארגון.' },
  { q: 'כמה אנשים אפשר להכשיר?', a: 'הרצאה: ללא הגבלה. סדנה: 8 עד 25. קורס: 10 עד 30. למחלקות גדולות בונים סדרה.' },
];
const schema = [breadcrumbSchema(crumbs), faqSchema(faq), serviceSchema({ name: 'הכשרת AI לארגונים', description, path, serviceType: 'Corporate AI training', audience: 'Companies in Israel' })];
const paths = [
  { who: 'HR ו-L&D', what: 'הרצאה לכל הארגון + סדנת "AI בעבודה" לצוותים', href: '/lectures' },
  { who: 'תפעול, שירות, מכירות', what: 'סדנת n8n: אוטומציה על תהליך אמיתי תוך יום', href: '/workshops' },
  { who: 'פיתוח ומוצר', what: 'יום Claude Code או בוטקמפ סוכני AI', href: '/courses' },
  { who: 'הנהלה', what: 'ליווי אישי: אסטרטגיית AI ותוכנית לרבעון', href: '/executive' },
];
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <section class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container-x relative py-12 md:py-20">
      <Breadcrumbs items={crumbs} />
      <h1 class="h1 mt-6 max-w-4xl">הכשרת AI לארגונים שרוצים תוצאות, לא מצגות</h1>
      <p class="lead mt-5 max-w-3xl">הרצאות, סדנאות וקורסי AI לחברות ולצוותים, מועברים על ידי אנשים שבנו אסטרטגיית AI, סוכנים ואוטומציות בפרודקשן. כל מפגש מסתיים במשהו שעובד ובמספר שאפשר להציג.</p>
      <div class="mt-8 flex flex-wrap gap-3"><a href="#contact-cta" class="btn btn-primary">בואו נדבר</a><a href="/workshops" class="btn btn-ghost">לסדנאות</a></div>
    </div>
  </section>
  <section class="py-14"><div class="container-x">
    <h2 class="h2">מסלול לפי צוות</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {paths.map((p) => <a href={p.href} class="card reveal flex items-start justify-between gap-4 p-6 hover:border-accent"><div><p class="text-sm text-muted">{p.who}</p><p class="mt-1 text-lg font-semibold">{p.what}</p></div><span class="text-accent">←</span></a>)}
    </div>
  </div></section>
  <ProofBlocks />
  <!-- Testimonials for companies: hidden until genuine quotes are collected (TODO.md). -->
  <FAQ items={faq} />
  <RelatedArticles slugs={['ai-course-for-employees-sample-syllabus', 'measuring-ai-training-success', 'ai-lecture-for-employees-what-to-include', 'why-employees-dont-use-ai-tools', 'ai-workshop-for-hr-teams', 'ai-adoption-90-day-plan']} />
  <CTA whatsappMessage="שלום, אני מחברה ואשמח לשמוע על הכשרת AI לצוות שלנו." audienceType="company" topic="חברות" trackLabel="companies" title="בואו נבנה תוכנית AI לצוות שלכם" />
</BaseLayout>
