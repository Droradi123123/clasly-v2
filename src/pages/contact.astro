---
import PageLayout from '@/layouts/PageLayout.astro';
import LeadForm from '@/components/LeadForm.astro';
import { whatsappUrl, CONTACT_EMAIL, PHONE_DISPLAY, PHONE_E164 } from '@/config/site';
const path = '/contact';
---
<PageLayout title="צור קשר: הרצאה, סדנה או קורס AI לארגון" description="דברו איתנו על הרצאה, סדנה, קורס או ליווי AI לארגון שלכם. וואטסאפ, אימייל או טופס קצר. מענה תוך יום עסקים." path={path} h1="בואו נדבר" lead="ספרו לנו מה הארגון צריך, ונחזור אליכם תוך יום עסקים עם הצעה ראשונית." wide>
  <div class="grid gap-8 md:grid-cols-2">
    <div class="space-y-4">
      <a href={whatsappUrl('שלום, אשמח לדבר על הרצאה או סדנת AI.')} target="_blank" rel="noopener" class="btn btn-primary w-full" data-track="whatsapp_click" data-track-label="contact">וואטסאפ: הדרך המהירה ביותר</a>
      <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-ghost w-full">{CONTACT_EMAIL}</a>
      <a href={`tel:${PHONE_E164}`} class="btn btn-ghost w-full" dir="ltr">{PHONE_DISPLAY}</a>
      <div class="card p-5 text-sm text-muted">
        <p class="font-bold text-fg">כדי שנחזור עם תשובה מדויקת, ספרו לנו:</p>
        <ul class="mt-2 space-y-1"><li>מי אתם (מוסד אקדמי, חברה או מנהל)</li><li>הפורמט (הרצאה, סדנה, קורס או ליווי)</li><li>גודל הקבוצה ומועד משוער</li><li>הנושא או האתגר שעל הפרק</li></ul>
      </div>
    </div>
    <LeadForm compact />
  </div>
</PageLayout>
