---
/**
 * Internal Google Analytics + Search Console report, from the latest snapshots in D1 (src/lib/analytics.ts).
 * Protected with HTTP Basic auth (ADMIN_PASSWORD secret), like /admin/leads. "Refresh" pulls fresh data now.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEnv } from '@/lib/env';
import { db } from '@/lib/db';
import { syncAnalytics, latestSnapshots, analyticsConfigured } from '@/lib/analytics';
export const prerender = false;

const env = getEnv();
const auth = Astro.request.headers.get('authorization') ?? '';
const expected = env.ADMIN_PASSWORD ? `Basic ${btoa(`admin:${env.ADMIN_PASSWORD}`)}` : null;
if (!expected || auth !== expected) {
  return new Response('Authentication required', { status: 401, headers: { 'www-authenticate': 'Basic realm="analytics", charset="UTF-8"', 'x-robots-tag': 'noindex' } });
}
const database = db();
if (Astro.request.method === 'POST' && database) {
  await syncAnalytics({ ...env, DB: database });
  return Astro.redirect('/admin/analytics', 303);
}
const configured = analyticsConfigured(env);
const snap = database ? await latestSnapshots(database) : null;
const ga = snap?.ga4?.data;
const gsc = snap?.gsc?.data;
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
Astro.response.headers.set('cache-control', 'no-store');
const n = (v: unknown, d = 0) => (typeof v === 'number' ? v.toLocaleString('he-IL', { maximumFractionDigits: d }) : '0');
const pct = (v: unknown) => (typeof v === 'number' ? `${(v * 100).toFixed(1)}%` : '');
const short = (u: string) => u.replace('https://realai.co.il', '') || '/';
---
<BaseLayout title="אנליטיקס" description="דוח פנימי" path="/admin/analytics" noindex hideHeader>
  <section class="container-x py-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="h2">אנליטיקס ו-Search Console</h1>
      <form method="post"><button class="btn btn-primary">רענון נתונים עכשיו</button></form>
    </div>
    {!database && <p class="mt-4 text-muted">מסד הנתונים לא מחובר (binding בשם DB).</p>}
    {!configured.gsc && <p class="mt-4">חסר הסוד <code>GOOGLE_SA_KEY</code> בהגדרות ה-Worker.</p>}
    {configured.gsc && !configured.ga4 && <p class="mt-4">חסר הסוד <code>GA4_PROPERTY_ID</code>, ולכן נמשכים רק נתוני Search Console.</p>}
    {snap?.errors.map((e) => <p class="mt-3 text-sm"><strong>שגיאה אחרונה ב-{e.source}:</strong> {e.error} <span class="text-muted">({new Date(e.created_at).toLocaleString('he-IL')})</span></p>)}

    {gsc && (
      <div class="mt-10">
        <h2 class="h3">Search Console <span class="text-sm text-muted">{snap!.gsc!.start_date} עד {snap!.gsc!.end_date}</span></h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-4">
          <div class="card card-solid p-4"><p class="text-sm text-muted">קליקים</p><p class="text-2xl font-bold">{n(gsc.totals.clicks)}</p></div>
          <div class="card card-solid p-4"><p class="text-sm text-muted">חשיפות</p><p class="text-2xl font-bold">{n(gsc.totals.impressions)}</p></div>
          <div class="card card-solid p-4"><p class="text-sm text-muted">CTR</p><p class="text-2xl font-bold">{pct(gsc.totals.ctr)}</p></div>
          <div class="card card-solid p-4"><p class="text-sm text-muted">מיקום ממוצע</p><p class="text-2xl font-bold">{n(gsc.totals.position, 1)}</p></div>
        </div>
        <h3 class="mt-8 font-bold">שאילתות</h3>
        <div class="mt-2 overflow-x-auto"><table class="w-full text-sm">
          <thead><tr class="text-muted"><th class="p-2 text-start">שאילתה</th><th class="p-2 text-start">קליקים</th><th class="p-2 text-start">חשיפות</th><th class="p-2 text-start">CTR</th><th class="p-2 text-start">מיקום</th></tr></thead>
          <tbody>{gsc.queries.slice(0, 50).map((r: any) => <tr class="border-t border-line"><td class="p-2">{r.keys[0]}</td><td class="p-2">{n(r.clicks)}</td><td class="p-2">{n(r.impressions)}</td><td class="p-2">{pct(r.ctr)}</td><td class="p-2">{n(r.position, 1)}</td></tr>)}</tbody>
        </table></div>
        <h3 class="mt-8 font-bold">עמודים</h3>
        <div class="mt-2 overflow-x-auto"><table class="w-full text-sm">
          <thead><tr class="text-muted"><th class="p-2 text-start">עמוד</th><th class="p-2 text-start">קליקים</th><th class="p-2 text-start">חשיפות</th><th class="p-2 text-start">מיקום</th></tr></thead>
          <tbody>{gsc.pages.slice(0, 50).map((r: any) => <tr class="border-t border-line"><td class="p-2" dir="ltr">{short(r.keys[0])}</td><td class="p-2">{n(r.clicks)}</td><td class="p-2">{n(r.impressions)}</td><td class="p-2">{n(r.position, 1)}</td></tr>)}</tbody>
        </table></div>
      </div>
    )}

    {ga && (
      <div class="mt-12">
        <h2 class="h3">Google Analytics <span class="text-sm text-muted">{snap!.ga4!.start_date} עד {snap!.ga4!.end_date}</span></h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-4">
          <div class="card card-solid p-4"><p class="text-sm text-muted">ביקורים</p><p class="text-2xl font-bold">{n(ga.totals.sessions)}</p></div>
          <div class="card card-solid p-4"><p class="text-sm text-muted">משתמשים</p><p class="text-2xl font-bold">{n(ga.totals.totalUsers)}</p></div>
          <div class="card card-solid p-4"><p class="text-sm text-muted">צפיות בעמודים</p><p class="text-2xl font-bold">{n(ga.totals.screenPageViews)}</p></div>
          <div class="card card-solid p-4"><p class="text-sm text-muted">שיעור מעורבות</p><p class="text-2xl font-bold">{pct(ga.totals.engagementRate)}</p></div>
        </div>
        <h3 class="mt-8 font-bold">ערוצים</h3>
        <div class="mt-2 overflow-x-auto"><table class="w-full text-sm">
          <thead><tr class="text-muted"><th class="p-2 text-start">ערוץ</th><th class="p-2 text-start">ביקורים</th><th class="p-2 text-start">מעורבים</th><th class="p-2 text-start">אירועי מפתח</th></tr></thead>
          <tbody>{ga.channels.map((r: any) => <tr class="border-t border-line"><td class="p-2" dir="ltr">{r.sessionDefaultChannelGroup}</td><td class="p-2">{n(r.sessions)}</td><td class="p-2">{n(r.engagedSessions)}</td><td class="p-2">{n(r.keyEvents)}</td></tr>)}</tbody>
        </table></div>
        <h3 class="mt-8 font-bold">עמודי נחיתה</h3>
        <div class="mt-2 overflow-x-auto"><table class="w-full text-sm">
          <thead><tr class="text-muted"><th class="p-2 text-start">עמוד</th><th class="p-2 text-start">ביקורים</th><th class="p-2 text-start">מעורבות</th><th class="p-2 text-start">זמן ממוצע (שניות)</th></tr></thead>
          <tbody>{ga.landingPages.slice(0, 40).map((r: any) => <tr class="border-t border-line"><td class="p-2" dir="ltr">{r.landingPage}</td><td class="p-2">{n(r.sessions)}</td><td class="p-2">{pct(r.engagementRate)}</td><td class="p-2">{n(r.averageSessionDuration)}</td></tr>)}</tbody>
        </table></div>
      </div>
    )}
    {snap && !ga && !gsc && configured.gsc && <p class="mt-8 text-muted">עוד אין נתונים. לחצו על "רענון נתונים עכשיו".</p>}
  </section>
</BaseLayout>
