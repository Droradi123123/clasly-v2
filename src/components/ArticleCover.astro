---
/**
 * Generated cover illustration for an article: one visual language per topic hub, varied by a seed from the slug,
 * so every article has its own image and each topic stays recognisable. Inline SVG in the site palette
 * (ink, one blue, light ground); decorative, so it is hidden from assistive tech.
 */
interface Props { slug: string; topic: string; class?: string }
const { slug, topic, class: cls = '' } = Astro.props;

// Small deterministic PRNG seeded from the slug.
let h = 2166136261;
for (const c of slug) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
let seed = h >>> 0;
const rnd = () => { seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
const r = (a: number, b: number) => a + rnd() * (b - a);
const ri = (a: number, b: number) => Math.floor(r(a, b + 1));
const W = 400, H = 225;
const INK = '#141414', BLUE = '#1f3fd1', SOFT = '#dfe5fb', LINE = '#c9c9c3', GROUND = '#f4f4f1';
type El = { t: 'rect' | 'circle' | 'line' | 'path'; a: Record<string, string | number> };
const els: El[] = [];
const rect = (x: number, y: number, w: number, hh: number, fill: string, extra: Record<string, string | number> = {}) => els.push({ t: 'rect', a: { x, y, width: w, height: hh, fill, ...extra } });
const circle = (cx: number, cy: number, rr: number, fill: string, extra: Record<string, string | number> = {}) => els.push({ t: 'circle', a: { cx, cy, r: rr, fill, ...extra } });
const line = (x1: number, y1: number, x2: number, y2: number, stroke: string, sw = 2) => els.push({ t: 'line', a: { x1, y1, x2, y2, stroke, 'stroke-width': sw, 'stroke-linecap': 'round' } });
const path = (d: string, stroke: string, sw = 2.5, fill = 'none') => els.push({ t: 'path', a: { d, stroke, 'stroke-width': sw, fill, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } });

switch (topic) {
  case 'ai-agents': {
    // A hub agent connected to tools around it.
    const cx = r(170, 230), cy = r(95, 130), n = ri(5, 8);
    const pts = Array.from({ length: n }, (_, i) => { const a = (i / n) * Math.PI * 2 + r(-.3, .3); const d = r(70, 95); return [cx + Math.cos(a) * d * 1.5, cy + Math.sin(a) * d * .8]; });
    pts.forEach(([x, y], i) => { line(cx, cy, x, y, i % 3 === 0 ? BLUE : LINE, i % 3 === 0 ? 2.5 : 1.5); });
    pts.forEach(([x, y], i) => i % 3 === 0 ? circle(x, y, 9, BLUE) : rect(x - 9, y - 9, 18, 18, GROUND, { stroke: INK, 'stroke-width': 2, rx: 4 }));
    circle(cx, cy, 24, INK); circle(cx, cy, 9, GROUND);
    break;
  }
  case 'n8n': {
    // A workflow: boxes left to right with a branch.
    const n = ri(3, 4), y = r(80, 100), gap = (W - 80) / n;
    const xs = Array.from({ length: n }, (_, i) => 40 + i * gap);
    xs.forEach((x, i) => { if (i < n - 1) path(`M${x + 54} ${y + 20} C ${x + gap - 20} ${y + 20}, ${x + 74} ${y + 20}, ${x + gap} ${y + 20}`, INK, 2); });
    const bi = ri(0, n - 2), down = y + r(52, 62), by = down + 40 <= H - 12 && rnd() > .4 ? down : y - r(52, 62);
    path(`M${xs[bi] + 27} ${y + 40} C ${xs[bi] + 27} ${by + 10}, ${xs[bi] + 60} ${by + 20}, ${xs[bi] + gap} ${by + 20}`, BLUE, 2.5);
    rect(xs[bi] + gap, by, 54, 40, SOFT, { rx: 8, stroke: BLUE, 'stroke-width': 2 });
    xs.forEach((x, i) => rect(x, y, 54, 40, i === 0 ? INK : GROUND, { rx: 8, stroke: INK, 'stroke-width': 2 }));
    circle(xs[0] + 27, y + 20, 6, GROUND);
    break;
  }
  case 'claude-code': {
    // A terminal window with code lines and a cursor.
    const x = r(40, 70), y = r(28, 40), w = W - x * 2, hh = H - y * 2;
    rect(x, y, w, hh, INK, { rx: 10 });
    [0, 1, 2].forEach((i) => circle(x + 18 + i * 14, y + 16, 4, i === 0 ? BLUE : '#555'));
    let ly = y + 42; const lines = ri(5, 7);
    for (let i = 0; i < lines; i++) { const ind = ri(0, 2) * 16; const lw = r(.25, .7) * (w - 60); rect(x + 24 + ind, ly, lw, 7, i === lines - 2 ? BLUE : '#6d6d6d', { rx: 3.5 }); ly += 18; }
    rect(x + 24, ly, 10, 12, BLUE);
    break;
  }
  case 'ai-roi': {
    // Bars growing, with a trend line.
    const n = ri(6, 8), base = H - 40, bw = (W - 100) / n;
    let v = r(.15, .3); const tops: number[][] = [];
    for (let i = 0; i < n; i++) { v = Math.min(.95, v + r(.03, .16)); const hh = v * (H - 80); const x = 50 + i * bw; rect(x + 6, base - hh, bw - 12, hh, i === n - 1 ? BLUE : SOFT, { rx: 3 }); tops.push([x + bw / 2, base - hh - 10]); }
    path('M' + tops.map(([x, y]) => `${x} ${y}`).join(' L'), INK, 2.5);
    line(40, base, W - 40, base, INK, 2);
    circle(tops[n - 1][0], tops[n - 1][1], 6, BLUE);
    break;
  }
  case 'ai-adoption': {
    // A field of people; adoption spreading from a few.
    const cols = 16, rows = 8, gx = (W - 60) / cols, gy = (H - 50) / rows;
    const seeds = Array.from({ length: ri(2, 3) }, () => [ri(0, cols - 1), ri(0, rows - 1)]);
    const reach = r(3, 5.5);
    for (let i = 0; i < cols; i++) for (let j = 0; j < rows; j++) {
      const d = Math.min(...seeds.map(([a, b]) => Math.hypot(a - i, (b - j) * 1.3)));
      const x = 30 + i * gx + gx / 2, y = 25 + j * gy + gy / 2;
      if (d < .5) circle(x, y, 7, INK); else if (d < reach) circle(x, y, 5.5, BLUE); else circle(x, y, 3.5, LINE);
    }
    break;
  }
  case 'building-with-ai': {
    // Stacked blocks being built, one in the air.
    const base = H - 35, n = ri(3, 4); let x0 = r(110, 150);
    for (let row = 0; row < n; row++) { const count = n - row; for (let k = 0; k < count; k++) rect(x0 + k * 44 + row * 22, base - (row + 1) * 34, 40, 30, row === n - 1 && k === 0 ? BLUE : (row + k) % 2 ? SOFT : GROUND, { stroke: INK, 'stroke-width': 2, rx: 4 }); }
    const fx = x0 + n * 44 + r(10, 40), fy = r(30, 60);
    rect(fx, fy, 40, 30, BLUE, { rx: 4, transform: `rotate(${r(-14, 14).toFixed(1)} ${fx + 20} ${fy + 15})` });
    path(`M${fx + 20} ${fy + 38} L${fx + 20} ${fy + 60}`, BLUE, 2);
    line(60, base, W - 60, base, INK, 2);
    break;
  }
  default: {
    // ai-for-managers: a roadmap with milestones and a destination.
    const y0 = r(150, 175), pts: number[][] = [];
    for (let i = 0; i <= 4; i++) pts.push([50 + i * 75, y0 - i * r(18, 30)]);
    path('M' + pts.map(([x, y], i) => i ? `C ${x - 45} ${pts[i - 1][1]}, ${x - 30} ${y}, ${x} ${y}` : `${x} ${y}`).join(' '), INK, 2.5);
    pts.slice(0, -1).forEach(([x, y]) => { circle(x, y, 9, GROUND, { stroke: INK, 'stroke-width': 2 }); });
    const [fx, fy] = pts[4]; line(fx, fy, fx, fy - 46, INK, 2.5); path(`M${fx} ${fy - 46} L${fx + 30} ${fy - 38} L${fx} ${fy - 28} Z`, BLUE, 2, BLUE);
    circle(fx, fy, 6, BLUE);
  }
}
const attrs = (a: Record<string, string | number>) => Object.entries(a).map(([k, v]) => `${k}="${typeof v === 'number' ? +v.toFixed(1) : v}"`).join(' ');
const shapes = els.map((e) => `<${e.t} ${attrs(e.a)}/>`).join('');
// Flows read right to left on a Hebrew page.
const body = topic === 'n8n' ? `<g transform="translate(${W} 0) scale(-1 1)">${shapes}</g>` : shapes;
---
<svg class={`block h-auto w-full ${cls}`} viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true" focusable="false" set:html={`<rect width="${W}" height="${H}" fill="${GROUND}"/>${body}`}></svg>
