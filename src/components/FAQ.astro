---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'שאלות נפוצות' } = Astro.props;
---
<section class="py-16" aria-labelledby="faq-title">
  <div class="container-x max-w-3xl">
    <h2 id="faq-title" class="h2">{title}</h2>
    <div class="mt-8 divide-y divide-line border-y border-line">
      {items.map((f) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold">
            <span>{f.q}</span>
            <span class="text-accent transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
