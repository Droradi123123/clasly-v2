---
import { BRAND_NAME, NAV, whatsappUrl } from '@/config/site';
import Wordmark from './Wordmark.astro';
const current = Astro.url.pathname;
const wa = whatsappUrl('שלום, אשמח לשמוע על הרצאות וסדנאות AI לארגון שלנו.');
---
<header class="sticky top-0 z-40 border-b border-line bg-bg">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="text-2xl" aria-label={`${BRAND_NAME}, דף הבית`}>
      <Wordmark />
    </a>
    <nav aria-label="ניווט ראשי" class="hidden md:block">
      <ul class="flex items-center gap-7 text-[0.95rem] font-bold">
        {NAV.map((item) => (
          <li><a href={item.href} class={`underline-offset-[.45em] decoration-2 hover:underline hover:decoration-accent ${current.startsWith(item.href) ? 'underline decoration-accent' : ''}`} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={wa} class="btn btn-primary !min-h-10 !px-4 text-sm" data-track="whatsapp_click" data-track-label="header" target="_blank" rel="noopener">וואטסאפ</a>
      <details class="md:hidden relative">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center border border-line" aria-label="תפריט">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav aria-label="ניווט נייד" class="absolute left-0 mt-2 w-60 border border-line bg-bg p-2">
          <ul class="flex flex-col">
            {NAV.map((item) => (
              <li><a href={item.href} class="block px-3 py-2 font-bold hover:bg-soft">{item.label}</a></li>
            ))}
            <li><a href="/contact" class="block px-3 py-2 font-bold hover:bg-soft">צרו קשר</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
