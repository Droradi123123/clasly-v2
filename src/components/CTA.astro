---
import { whatsappUrl } from '@/config/site';
import LeadForm from './LeadForm.astro';
interface Props { title?: string; text?: string; whatsappMessage: string; audienceType?: 'academia' | 'company' | 'executive' | ''; topic?: string; trackLabel?: string }
const { title = 'בואו נבנה לכם את ההרצאה הנכונה', text = 'כתבו לנו בוואטסאפ מה הארגון צריך, או השאירו פרטים ונחזור תוך יום עסקים.', whatsappMessage, audienceType = '', topic = '', trackLabel = 'cta' } = Astro.props;
---
<section id="contact-cta" class="border-t border-line bg-accent-soft py-16 md:py-24" aria-labelledby="cta-title">
  <div class="container-x">
    <div class="grid gap-10 md:grid-cols-2 md:items-start md:gap-16">
      <div>
        <h2 id="cta-title" class="h2">{title}</h2>
        <p class="lead mt-4">{text}</p>
        <a href={whatsappUrl(whatsappMessage)} target="_blank" rel="noopener" class="btn btn-primary mt-8" data-track="whatsapp_click" data-track-label={trackLabel}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c1.7.7 2.1.6 2.8.5a2.4 2.4 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1l-.5-.1z"/></svg>
          שלחו לנו וואטסאפ
        </a>
        <p class="mt-3 text-sm text-muted">מענה ראשוני תוך יום עסקים. בלי התחייבות.</p>
      </div>
      <LeadForm audienceType={audienceType} topic={topic} />
    </div>
  </div>
</section>
