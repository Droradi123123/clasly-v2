---
import { PROOF_POINTS } from '@/config/site';
---
<section class="border-t border-line py-20 md:py-24" aria-labelledby="proof-title">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow">למה אנחנו</p>
      <h2 id="proof-title" class="h2 mt-3">אנחנו עושים את זה בחברות הטכנולוגיה המובילות. <span class="text-accent">ומשתפים אתכם בידע.</span></h2>
    </div>
    <div class="mt-12 grid gap-x-8 gap-y-10 md:grid-cols-3">
      {PROOF_POINTS.map((p, i) => (
        <article class="rule-top reveal" style={`transition-delay:${i * 90}ms`}>
          <h3 class="font-display text-3xl text-accent md:text-4xl">{p.stat}</h3>
          <p class="mt-3 text-muted">{p.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
