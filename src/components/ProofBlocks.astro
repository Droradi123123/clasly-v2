---
import { PROOF_POINTS } from '@/config/site';
---
<section class="py-20" aria-labelledby="proof-title">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow">למה אנחנו</p>
      <h2 id="proof-title" class="h2 mt-3">עשינו את זה בחברות הטכנולוגיה המובילות. <span class="text-gradient">עכשיו אנחנו משתפים את הידע.</span></h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {PROOF_POINTS.map((p, i) => (
        <article class="glow-card reveal p-7" style={`transition-delay:${i * 90}ms`}>
          <p class="text-gradient text-3xl font-black tracking-tight md:text-4xl">{p.stat}</p>
          <h3 class="h3 mt-4">{p.title}</h3>
          <p class="mt-3 text-muted">{p.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
