---
import { whatsappUrl } from '@/config/site';
const waBase = whatsappUrl('');
---
<div class="hero-agent card relative p-4 md:p-5" data-wa-base={waBase}>
  <form class="flex flex-col gap-3 sm:flex-row" aria-label="בניית מתווה להרצאה או סדנה">
    <label class="sr-only" for="agent-input">מה הארגון שלכם רוצה לעשות עם AI?</label>
    <input id="agent-input" name="prompt" type="text" maxlength="300" required autocomplete="off" enterkeyhint="send"
      placeholder="מה הארגון שלכם רוצה לעשות עם AI?"
      class="w-full flex-1 rounded-xl border border-line bg-bg px-4 py-3 text-base placeholder:text-muted focus:border-accent" />
    <button type="submit" class="btn btn-primary whitespace-nowrap">בנו לנו מתווה</button>
  </form>
  <div class="mt-2 flex flex-wrap gap-2 text-xs" aria-label="דוגמאות">
    <button type="button" class="chip inline-flex min-h-8 items-center rounded-full border border-line px-3 py-1 text-muted hover:border-accent hover:text-fg" data-example="להכניס סוכני AI למחלקת שירות הלקוחות">סוכנים בשירות לקוחות</button>
    <button type="button" class="chip inline-flex min-h-8 items-center rounded-full border border-line px-3 py-1 text-muted hover:border-accent hover:text-fg" data-example="להכשיר סטודנטים ליזמות לבנות מוצר עם Claude Code">סטודנטים ו-Claude Code</button>
    <button type="button" class="chip inline-flex min-h-8 items-center rounded-full border border-line px-3 py-1 text-muted hover:border-accent hover:text-fg" data-example="לחבר את ה-CRM והמייל לאוטומציות n8n בצוות המכירות">אוטומציות n8n למכירות</button>
  </div>
  <div class="agent-output mt-4 hidden" aria-live="polite">
    <div class="agent-body prose max-w-none rounded-xl border border-line bg-bg p-4 text-[0.98rem]"></div>
    <div class="agent-actions mt-3 hidden flex-wrap gap-2">
      <a class="btn btn-primary agent-wa" href="#" target="_blank" rel="noopener">שלחו לנו את זה בוואטסאפ</a>
      <button type="button" class="btn btn-ghost agent-copy">העתקת המתווה</button>
      <button type="button" class="btn btn-ghost agent-reset">מתווה חדש</button>
    </div>
  </div>
  <p class="agent-error mt-3 hidden text-sm text-red-400" role="alert"></p>
</div>
<script>
  /** Streams the outline from /api/outline and renders simple Markdown incrementally. */
  function renderMd(md: string): string {
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const inline = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    const lines = md.split('\n');
    let html = ''; let inList = false;
    for (const raw of lines) {
      const line = raw.trimEnd();
      if (/^\s*[-*] /.test(line)) { if (!inList) { html += '<ul>'; inList = true; } html += `<li>${inline(line.replace(/^\s*[-*] /, ''))}</li>`; continue; }
      if (inList) { html += '</ul>'; inList = false; }
      if (line.startsWith('## ')) html += `<h3>${inline(line.slice(3))}</h3>`;
      else if (line.startsWith('# ')) html += `<h2 class="!mt-0">${inline(line.slice(2))}</h2>`;
      else if (line.trim()) html += `<p>${inline(line)}</p>`;
    }
    if (inList) html += '</ul>';
    return html;
  }

  document.querySelectorAll<HTMLElement>('.hero-agent').forEach((root) => {
    const form = root.querySelector('form')!;
    const input = root.querySelector<HTMLInputElement>('#agent-input')!;
    const out = root.querySelector<HTMLElement>('.agent-output')!;
    const body = root.querySelector<HTMLElement>('.agent-body')!;
    const actions = root.querySelector<HTMLElement>('.agent-actions')!;
    const wa = root.querySelector<HTMLAnchorElement>('.agent-wa')!;
    const err = root.querySelector<HTMLElement>('.agent-error')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const waBase = root.dataset.waBase!;
    let text = ''; let sessionId: string | null = null; let busy = false;

    root.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((c) => c.addEventListener('click', () => { input.value = c.dataset.example!; form.requestSubmit(); }));
    root.querySelector('.agent-reset')!.addEventListener('click', () => { out.classList.add('hidden'); actions.classList.add('hidden'); body.innerHTML = ''; input.value = ''; input.focus(); });
    root.querySelector('.agent-copy')!.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(text); (window as any).__track?.('outline_copy', { session_id: sessionId }); } catch {}
    });
    wa.addEventListener('click', () => (window as any).__track?.('outline_whatsapp', { session_id: sessionId }));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;
      const prompt = input.value.trim();
      if (prompt.length < 6) { err.textContent = 'כתבו לפחות כמה מילים על מה שהארגון רוצה להשיג.'; err.classList.remove('hidden'); return; }
      busy = true; btn.disabled = true; err.classList.add('hidden');
      text = ''; body.innerHTML = ''; body.classList.add('cursor'); out.classList.remove('hidden'); actions.classList.add('hidden');
      try {
        const res = await fetch('/api/outline', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ prompt, page: location.pathname }) });
        if (!res.ok) { const d: any = await res.json().catch(() => ({})); throw new Error(d.error || 'משהו השתבש. נסו שוב.'); }
        sessionId = res.headers.get('x-session-id');
        const reader = res.body!.getReader(); const dec = new TextDecoder();
        let raf = 0;
        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          text += dec.decode(value, { stream: true });
          if (!raf) raf = requestAnimationFrame(() => { body.innerHTML = renderMd(text); raf = 0; });
        }
        body.innerHTML = renderMd(text);
        const msg = `שלום! בניתי מתווה באתר שלכם ואשמח לדבר עליו:\n\n${text}\n\nהבקשה המקורית: ${prompt}`;
        wa.href = waBase + encodeURIComponent(msg);
        actions.classList.remove('hidden'); actions.classList.add('flex');
        (window as any).__track?.('outline_generated', { session_id: sessionId });
      } catch (ex: any) {
        err.textContent = ex.message || 'משהו השתבש. נסו שוב או כתבו לנו בוואטסאפ.'; err.classList.remove('hidden');
        if (!text) out.classList.add('hidden');
      } finally { body.classList.remove('cursor'); busy = false; btn.disabled = false; }
    });
  });
</script>
