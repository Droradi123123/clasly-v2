---
/** What we teach: every topic hub as a chip, then the four formats as a line. The subjects are the product; the formats are how they are delivered. */
import { TOPICS, OFFERS } from '@/config/site';
import { offerBySlug } from '@/data/offers';
const lengthOf = (slug: (typeof OFFERS)[number]['slug']) => offerBySlug(slug).logistics.find((l) => l.label === 'אורך')?.value ?? '';
---
<section class="border-t border-line py-20 md:py-24" aria-labelledby="offers-title">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow">נושאים ופורמטים</p>
      <h2 id="offers-title" class="h2 mt-3">מה אנחנו מעבירים?</h2>
      <p class="lead mt-4">כל נושא זמין כהרצאה, סדנה, קורס או ליווי אישי. בעברית, פרונטלי או Zoom, לקהל טכני ולא טכני.</p>
    </div>
    <ul class="mt-10 flex flex-wrap gap-3" role="list">
      {TOPICS.map((t) => <li><a href={`/topics/${t.slug}`} class="chip">{t.name}</a></li>)}
    </ul>
    <ol class="mt-14 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {OFFERS.map((o) => (
        <li class="rule-top">
          <a href={o.href} class="group flex h-full flex-col">
            <h3 class="h3 group-hover:text-accent">{o.name}</h3>
            <p class="mt-2 text-sm text-muted">{lengthOf(o.slug)}</p>
            <p class="mt-3 flex-1">{o.value}</p>
            <span class="mt-4 inline-flex items-center gap-2 font-bold text-accent">לפרטים <span class="transition group-hover:-translate-x-1" aria-hidden="true">←</span></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
