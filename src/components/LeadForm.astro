---
import { SITE } from '@/config/site';
interface Props { audienceType?: 'academia' | 'company' | 'executive' | ''; topic?: string; compact?: boolean }
const { audienceType = '', topic = '', compact = false } = Astro.props;
---
<form class="lead-form card p-6" method="post" action="/api/lead" novalidate aria-describedby="form-help">
  <input type="hidden" name="audience_type" value={audienceType} />
  <input type="hidden" name="topic" value={topic} />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <div class={`grid gap-4 ${compact ? '' : 'sm:grid-cols-2'}`}>
    <label class="block text-sm">
      <span class="font-bold">שם</span>
      <input name="name" required minlength="2" autocomplete="name" class="mt-1 w-full rounded-xl border border-line bg-bg px-3 py-2.5 focus:border-accent" />
    </label>
    <label class="block text-sm">
      <span class="font-bold">ארגון</span>
      <input name="organization" required autocomplete="organization" class="mt-1 w-full rounded-xl border border-line bg-bg px-3 py-2.5 focus:border-accent" />
    </label>
    <label class="block text-sm sm:col-span-2">
      <span class="font-bold">טלפון או אימייל</span>
      <input name="contact" required autocomplete="on" inputmode="email" class="mt-1 w-full rounded-xl border border-line bg-bg px-3 py-2.5 focus:border-accent" />
    </label>
    <label class="block text-sm sm:col-span-2">
      <span class="font-bold">מה אתם צריכים?</span>
      <textarea name="message" required minlength="10" rows="3" placeholder="לדוגמה: סדנת n8n לצוות תפעול של 20 אנשים, בחודש הבא" class="mt-1 w-full rounded-xl border border-line bg-bg px-3 py-2.5 focus:border-accent"></textarea>
    </label>
  </div>
  {SITE.turnstileSiteKey && <div class="cf-turnstile mt-4" data-sitekey={SITE.turnstileSiteKey} data-language="he"></div>}
  <p id="form-help" class="mt-3 text-xs text-muted">נחזור אליכם תוך יום עסקים. הפרטים משמשים רק למענה על הפנייה.</p>
  <p class="form-error mt-2 hidden text-sm text-red-400" role="alert"></p>
  <button type="submit" class="btn btn-primary mt-4 w-full sm:w-auto">שלחו ונחזור אליכם</button>
  <p class="form-success mt-3 hidden text-accent" role="status">תודה! קיבלנו את הפנייה ונחזור אליכם תוך יום עסקים.</p>
</form>
{SITE.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  const messages: Record<string, string> = {
    name: 'הזינו שם (לפחות 2 תווים).',
    organization: 'הזינו את שם הארגון.',
    contact: 'הזינו מספר טלפון או כתובת אימייל תקינים.',
    message: 'ספרו לנו בכמה מילים מה אתם צריכים (לפחות 10 תווים).',
  };
  document.querySelectorAll<HTMLFormElement>('form.lead-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = form.querySelector<HTMLElement>('.form-error')!;
      const ok = form.querySelector<HTMLElement>('.form-success')!;
      err.classList.add('hidden'); ok.classList.add('hidden');
      for (const name of Object.keys(messages)) {
        const field = form.elements.namedItem(name) as HTMLInputElement;
        if (!field.checkValidity()) { err.textContent = messages[name]; err.classList.remove('hidden'); field.focus(); return; }
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      try {
        const res = await fetch('/api/lead', { method: 'POST', body: new FormData(form) });
        const data: any = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'השליחה נכשלה. נסו שוב.');
        form.reset(); ok.classList.remove('hidden');
        (window as any).__track?.('lead_form_submit', { audience_type: (form.elements.namedItem('audience_type') as HTMLInputElement).value });
      } catch (ex: any) {
        err.textContent = ex.message || 'משהו השתבש. נסו שוב או כתבו לנו בוואטסאפ.'; err.classList.remove('hidden');
      } finally { btn.disabled = false; }
    });
  });
</script>
