---
import { BRAND_NAME, FOOTER_LINKS, CONTACT_EMAIL, PHONE_DISPLAY, whatsappUrl } from '@/config/site';
import Wordmark from './Wordmark.astro';
const year = new Date().getFullYear();
const groups = [
  { title: 'מה אנחנו מעבירים', items: FOOTER_LINKS.offers },
  { title: 'למי', items: FOOTER_LINKS.audiences },
  { title: 'משאבים', items: FOOTER_LINKS.resources },
];
---
<footer class="mt-24 border-t border-line bg-elev/40">
  <div class="container-x py-14">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <p class="text-xl font-extrabold"><Wordmark /></p>
        <p class="mt-3 text-sm text-muted">הרצאות, סדנאות, קורסים וליווי למנהלים בנושאי AI יישומי. מועבר בעברית, מניסיון יישום אמיתי בתעשייה.</p>
        <p class="mt-4 text-sm"><a class="hover:text-accent" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
        <p class="mt-1 text-sm"><a class="hover:text-accent" href={whatsappUrl('שלום, אשמח לפרטים על הרצאות וסדנאות AI.')} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-label="footer">וואטסאפ: <span dir="ltr">{PHONE_DISPLAY}</span></a></p>
      </div>
      {groups.map((g) => (
        <nav aria-label={g.title}>
          <p class="font-semibold">{g.title}</p>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            {g.items.map((l) => <li><a class="hover:text-accent" href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-line pt-6 text-sm text-muted md:flex-row md:items-center md:justify-between">
      <p>
        <a href="/how-this-site-was-built" class="hover:text-accent">האתר הזה נבנה עם סוכני AI. רוצים ללמוד איך?</a>
      </p>
      <ul class="flex flex-wrap gap-4">
        {FOOTER_LINKS.legal.map((l) => <li><a class="hover:text-accent" href={l.href}>{l.label}</a></li>)}
        <li>© {year} {BRAND_NAME}</li>
      </ul>
    </div>
  </div>
</footer>
