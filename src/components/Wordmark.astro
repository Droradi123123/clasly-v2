---
/**
 * Brand wordmark: "RealAI" set in the display serif, closed with a red full stop.
 * Live text, not an image: crisp at any size, readable by engines, and it reads like a masthead, not an app icon.
 */
import { BRAND_NAME } from '@/config/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span dir="ltr" class={`font-display whitespace-nowrap font-bold leading-none ${cls}`}>{BRAND_NAME}<span class="text-accent" aria-hidden="true">.</span></span>
