---
/**
 * Hero toy: build an AI agent in three clicks, then run it. Pick a trigger, an action and a destination; the flow
 * redraws, and "Run" sends a sample message through it and types the result. It is a scripted demo (labelled as
 * one), not a live model call: instant, free, and always works. It shows the kind of thing participants build.
 */
const triggers = [
  { id: 'mail', label: 'מגיע מייל' },
  { id: 'form', label: 'נשלח טופס' },
  { id: 'wa', label: 'מגיעה הודעת וואטסאפ' },
];
const actions = [
  { id: 'sum', label: 'מסכם' },
  { id: 'tag', label: 'מסווג לפי דחיפות' },
  { id: 'reply', label: 'מנסח תשובה' },
];
const targets = [
  { id: 'slack', label: 'Slack' },
  { id: 'crm', label: 'CRM' },
  { id: 'sheet', label: 'אקסל' },
];
const rows = [
  { key: 'trigger', q: 'כש...', items: triggers },
  { key: 'action', q: 'האייג׳נט...', items: actions },
  { key: 'target', q: 'ושולח ל...', items: targets },
];
---
<div class="agent-toy" data-agent-toy>
  <div class="flex items-baseline justify-between gap-3">
    <p class="font-display text-xl">בנו אייג׳נט בשלושה קליקים</p>
    <span class="text-xs text-muted">הדגמה</span>
  </div>

  <div class="mt-4 space-y-3">
    {rows.map((r) => (
      <fieldset class="toy-row">
        <legend class="toy-q">{r.q}</legend>
        <div class="flex flex-wrap gap-2">
          {r.items.map((it, i) => (
            <button type="button" class="toy-chip" data-key={r.key} data-id={it.id} aria-pressed={i === 0 ? 'true' : 'false'}>{it.label}</button>
          ))}
        </div>
      </fieldset>
    ))}
  </div>

  <div class="toy-flow mt-6" aria-hidden="true">
    <span class="toy-fill"></span>
    <span class="toy-node" data-node="0"><b data-label="trigger">מגיע מייל</b></span>
    <span class="toy-node" data-node="1"><b data-label="action">מסכם</b></span>
    <span class="toy-node" data-node="2"><b data-label="target">Slack</b></span>
  </div>

  <button type="button" class="btn btn-primary mt-6 w-full" data-run>הפעילו את האייג׳נט</button>

  <div class="toy-out mt-4" aria-live="polite">
    <p class="text-xs font-bold text-muted" data-out-head>נכנס:</p>
    <p class="mt-1 text-sm" data-out-in>לחצו "הפעילו" ותראו מה קורה.</p>
    <p class="mt-3 text-xs font-bold text-accent" data-out-head2 hidden></p>
    <p class="mt-1 font-bold" data-out-res></p>
  </div>

  <a href="/workshops" class="mt-4 inline-block text-sm font-bold text-accent underline underline-offset-4">את זה בונים בסדנה, ביום אחד ←</a>
</div>

<style>
  .agent-toy { border: 1.5px solid var(--ink); border-radius: 6px; padding: 1.25rem; background: var(--paper); box-shadow: 6px 6px 0 var(--accent); }
  @media (min-width: 768px) { .agent-toy { padding: 1.5rem; } }
  .toy-row { border: 0; margin: 0; padding: 0; min-width: 0; }
  .toy-q { font-size: .85rem; font-weight: 700; color: var(--ink-2); margin-bottom: .4rem; }
  .toy-chip { border: 1.5px solid var(--rule); background: transparent; color: var(--ink); border-radius: 999px; padding: .35rem .85rem; font: inherit; font-size: .95rem; font-weight: 600; cursor: pointer; transition: border-color .15s, background .15s, color .15s, transform .15s; }
  .toy-chip:hover { border-color: var(--ink); }
  .toy-chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .toy-chip:active { transform: scale(.96); }
  .toy-flow { position: relative; display: flex; justify-content: space-between; align-items: center; gap: .5rem; padding-block: .25rem; }
  .toy-flow::before, .toy-fill { content: ""; position: absolute; inset-inline: 12%; top: 50%; height: 2px; background: var(--rule); }
  .toy-fill { background: var(--accent); transform-origin: right; transform: scaleX(0); }
  .toy-node { position: relative; z-index: 1; flex: 1 1 0; min-width: 0; display: flex; justify-content: center; }
  .toy-node b { display: inline-block; max-width: 100%; padding: .45rem .6rem; border: 1.5px solid var(--ink); border-radius: 6px; background: var(--paper); font-size: .8rem; text-align: center; line-height: 1.25; transition: background .2s, color .2s, transform .2s; }
  .toy-node.lit b { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); transform: translateY(-2px); }
  .toy-node.swap b { animation: toy-pop .35s ease; }
  @keyframes toy-pop { 50% { transform: scale(1.08); } }
  .toy-out { min-height: 6.5rem; border-top: 1px dashed var(--rule); padding-top: .75rem; }
  @media (prefers-reduced-motion: reduce) { .toy-node.swap b { animation: none; } .toy-fill { transition: none !important; } }
</style>

<script>
  type Key = 'trigger' | 'action' | 'target';
  const SAMPLE: Record<string, { input: string; sum: string; tag: string; reply: string }> = {
    mail: {
      input: '"שלום, אנחנו מחפשים סדנת AI ל-25 עובדי תפעול לפני סוף הרבעון. אפשר הצעת מחיר?"',
      sum: 'בקשת הצעת מחיר: סדנת AI, 25 עובדי תפעול, עד סוף הרבעון.',
      tag: 'דחוף · ליד חם · סדנה · 25 משתתפים',
      reply: '"תודה! נשמח לבנות לכם סדנה ל-25 משתתפים. מתי נוח לשיחה של 15 דקות השבוע?"',
    },
    form: {
      input: '"שם: מיכל. ארגון: מכללה. צריך: קורס AI לסטודנטים בסמסטר הבא."',
      sum: 'מכללה מבקשת קורס AI לסטודנטים, לסמסטר הבא. איש קשר: מיכל.',
      tag: 'רגיל · אקדמיה · קורס · סמסטר הבא',
      reply: '"היי מיכל, תודה על הפנייה. נשלח לך סילבוס לדוגמה עוד היום ונתאם שיחה."',
    },
    wa: {
      input: '"היי, יש לכם הרצאה על AI להנהלה? יש לנו כנס ב-12 לחודש."',
      sum: 'הרצאת AI להנהלה בכנס, ב-12 לחודש. צריך לבדוק זמינות.',
      tag: 'דחוף · תאריך קרוב · הרצאה · הנהלה',
      reply: '"היי! ה-12 עדיין פנוי אצלנו. כמה משתתפים צפויים, וכמה זמן מוקצב להרצאה?"',
    },
  };
  const DEST: Record<string, string> = { slack: 'נשלח ל-Slack, ערוץ #לידים:', crm: 'נוצר כרטיס ב-CRM:', sheet: 'נוספה שורה לאקסל:' };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-agent-toy]').forEach((root) => {
    const state: Record<Key, string> = { trigger: 'mail', action: 'sum', target: 'slack' };
    const fill = root.querySelector<HTMLElement>('.toy-fill')!;
    const nodes = [...root.querySelectorAll<HTMLElement>('.toy-node')];
    const outIn = root.querySelector<HTMLElement>('[data-out-in]')!;
    const head2 = root.querySelector<HTMLElement>('[data-out-head2]')!;
    const res = root.querySelector<HTMLElement>('[data-out-res]')!;
    const run = root.querySelector<HTMLButtonElement>('[data-run]')!;
    let timers: number[] = [];
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const reset = () => {
      clear(); nodes.forEach((n) => n.classList.remove('lit'));
      fill.style.transition = 'none'; fill.style.transform = 'scaleX(0)';
      head2.hidden = true; res.textContent = '';
      outIn.textContent = 'לחצו "הפעילו" ותראו מה קורה.';
      run.disabled = false;
    };

    root.querySelectorAll<HTMLButtonElement>('.toy-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const key = chip.dataset.key as Key;
        state[key] = chip.dataset.id!;
        root.querySelectorAll<HTMLButtonElement>(`.toy-chip[data-key="${key}"]`).forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        const label = root.querySelector<HTMLElement>(`[data-label="${key}"]`)!;
        label.textContent = chip.textContent;
        const node = label.parentElement!; node.classList.remove('swap'); void node.offsetWidth; node.classList.add('swap');
        reset();
      });
    });

    run.addEventListener('click', () => {
      reset(); run.disabled = true;
      const s = SAMPLE[state.trigger];
      const result = s[state.action as 'sum' | 'tag' | 'reply'];
      outIn.textContent = s.input;
      if (reduce) {
        nodes.forEach((n) => n.classList.add('lit')); fill.style.transform = 'scaleX(1)';
        head2.textContent = DEST[state.target]; head2.hidden = false; res.textContent = result; run.disabled = false;
        (window as any).__track?.('agent_toy_run', { label: `${state.trigger}-${state.action}-${state.target}` });
        return;
      }
      nodes[0].classList.add('lit');
      timers.push(window.setTimeout(() => { fill.style.transition = 'transform 1.1s cubic-bezier(.4,0,.2,1)'; fill.style.transform = 'scaleX(1)'; }, 250));
      timers.push(window.setTimeout(() => nodes[1].classList.add('lit'), 800));
      timers.push(window.setTimeout(() => nodes[2].classList.add('lit'), 1350));
      timers.push(window.setTimeout(() => {
        head2.textContent = DEST[state.target]; head2.hidden = false;
        let i = 0;
        const type = () => { res.textContent = result.slice(0, ++i); if (i < result.length) timers.push(window.setTimeout(type, 18)); else run.disabled = false; };
        type();
      }, 1500));
      (window as any).__track?.('agent_toy_run', { label: `${state.trigger}-${state.action}-${state.target}` });
    });
  });
</script>
