---
/** The core message: the gap between learning AI from videos and implementing it in a real organization. */
const learned = [
  '10 כלי AI שחייבים להכיר החודש',
  'הפרומפט המושלם שיחליף לכם עובד',
  'דמו מרשים שעובד פעם אחת',
  'AI יחליף את כולם עד סוף השנה',
  'מצגת עם הרבה חיצים',
];
const done = [
  'איך גורמים לאלפי עובדים להשתמש בזה כל יום, ולא רק בשבוע הראשון',
  'איך עוברים אבטחת מידע, משפטית ורכש בלי לאבד חצי שנה',
  'מה נשבר בפרודקשן, ואיך בונים ניטור שאנשים סומכים עליו',
  'איך מודדים ROI שההנהלה מוכנה לחתום עליו',
  'מה עושים כשהמודל טועה מול לקוח אמיתי',
];
---
<section class="border-t border-line py-20 md:py-28" aria-labelledby="gap-title">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow">הפער</p>
      <h2 id="gap-title" class="h2 mt-3">יש פער עצום בין מי שלמד AI ביוטיוב לבין מי שהטמיע אותו בארגון.</h2>
      <p class="lead mt-5 max-w-2xl">את הכלים כולם כבר מכירים. הקושי מתחיל ביום שאחרי: אנשים, תהליכים, אבטחה ומדידה. את זה לומדים רק מבפנים.</p>
    </div>
    <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <p class="rule-top text-sm font-bold text-muted">מה שלומדים מסרטונים</p>
        <ul class="strike-list mt-4 divide-y divide-line text-lg" data-inview>
          {learned.map((t) => <li class="py-3"><span>{t}</span></li>)}
        </ul>
      </div>
      <div>
        <p class="rule-top text-sm font-bold text-accent">מה שלומדים כשמטמיעים בארגון של אלפי עובדים</p>
        <ul class="check-list mt-4 divide-y divide-line text-lg" data-inview>
          {done.map((t, i) => (
            <li class="flex gap-4 py-3">
              <span class="font-display text-accent" aria-hidden="true">{i + 1}.</span>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="font-display mx-auto mt-16 max-w-3xl text-center text-2xl font-bold leading-snug md:text-4xl">את הרשימה השנייה אי אפשר ללמוד מסרטון. <span class="text-accent">אותה אנחנו מלמדים בארגון שלכם.</span></p>
  </div>
</section>
