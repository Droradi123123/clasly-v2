---
import { OFFERS } from '@/config/site';
interface Props { title?: string; exclude?: string }
const { title = 'מה אנחנו מעבירים לארגונים?', exclude } = Astro.props;
const offers = OFFERS.filter((o) => o.slug !== exclude);
---
<section class="py-20" aria-labelledby="offers-title">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow">דרכים לעבוד איתנו</p>
      <h2 id="offers-title" class="h2 mt-3">{title}</h2>
      <p class="lead mt-4">כל תוכנית נבנית סביב הארגון שלכם: הקהל, האתגר והקצב. מתחילים בשיחה, לא בקטלוג.</p>
    </div>
    <div class={`mt-12 grid gap-5 sm:grid-cols-2 ${offers.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}>
      {offers.map((o, i) => (
        <a href={o.href} class="glow-card reveal group flex flex-col p-7" style={`transition-delay:${i * 70}ms`}>
          <span class="text-sm font-bold text-muted" aria-hidden="true">0{i + 1}</span>
          <h3 class="mt-3 text-2xl font-bold">{o.name}</h3>
          <p class="mt-3 flex-1 text-muted">{o.value}</p>
          <p class="mt-5 text-sm"><span class="text-muted">למי: </span>{o.audience}</p>
          <span class="mt-6 inline-flex items-center gap-2 font-bold text-accent">לפרטים <span class="transition group-hover:-translate-x-1" aria-hidden="true">←</span></span>
        </a>
      ))}
    </div>
  </div>
</section>
