---
import { OFFERS } from '@/config/site';
interface Props { title?: string; exclude?: string }
const { title = 'ארבע דרכים ללמוד איתנו', exclude } = Astro.props;
const offers = OFFERS.filter((o) => o.slug !== exclude);
---
<section class="py-16" aria-labelledby="offers-title">
  <div class="container-x">
    <p class="eyebrow">מה אנחנו מעבירים</p>
    <h2 id="offers-title" class="h2 mt-2">{title}</h2>
    <div class={`mt-10 grid gap-5 sm:grid-cols-2 ${offers.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}>
      {offers.map((o) => (
        <a href={o.href} class="card reveal group flex flex-col p-6 transition hover:border-accent">
          <h3 class="h3 group-hover:text-accent">{o.name}</h3>
          <p class="mt-3 flex-1 text-muted">{o.value}</p>
          <dl class="mt-5 space-y-1 text-sm">
            <div class="flex gap-2"><dt class="text-muted">למי:</dt><dd>{o.audience}</dd></div>
            <div class="flex gap-2"><dt class="text-muted">אורך:</dt><dd>{o.length}</dd></div>
          </dl>
          <span class="mt-5 font-semibold text-accent">לפרטים ←</span>
        </a>
      ))}
    </div>
  </div>
</section>
