---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQ from '@/components/FAQ.astro';
import CTA from '@/components/CTA.astro';
import ArticleCover from '@/components/ArticleCover.astro';
import { TOPICS, OFFERS, whatsappUrl, offerAnchor } from '@/config/site';
import { breadcrumbSchema, faqSchema, articleSchema, ogPathFor } from '@/lib/seo';
import { COURSE_PAGES } from '@/data/courses';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'blog'>; related: CollectionEntry<'blog'>[]; toc?: { slug: string; text: string }[]; words?: number }
const { entry, related, toc = [], words = 0 } = Astro.props;
const minutes = Math.max(3, Math.round(words / 200));
const d = entry.data;
const path = `/blog/${d.slug}`;
const topic = TOPICS.find((t) => t.slug === d.topicHub)!;
const offer = OFFERS.find((o) => o.href === d.relatedOffer)!;
const crumbs = [{ name: 'דף הבית', path: '/' }, { name: 'בלוג', path: '/blog' }, { name: topic.name, path: `/topics/${topic.slug}` }, { name: d.title, path }];
const iso = (x: Date) => x.toISOString().slice(0, 10);
const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ title: d.title, description: d.description, path, publishedAt: iso(d.publishedAt), updatedAt: iso(d.updatedAt), image: ogPathFor(path), keywords: [d.focusKeyPhrase, ...d.keywords], section: topic.name, words, minutes, about: d.focusKeyPhrase, audience: d.topicHub === 'ai-in-education' ? 'educator' : undefined, figures: [...(entry.body ?? '').matchAll(/<img\b[^>]*\ssrc="(\/blog\/[^"]+)"/g)].map((m) => m[1]) }),
  faqSchema(d.faq),
];
// One link to the audience page, with a search phrase as its text (varied by slug).
const pick = (list: string[]) => { let h = 0; for (const c of d.slug) h = (h * 31 + c.charCodeAt(0)) >>> 0; return list[h % list.length]; };
const audienceLink = d.topicHub === 'ai-in-education'
  ? { href: '/academia', lead: 'למוסדות אקדמיים:', text: pick(['קורס בינה מלאכותית לאקדמיה', 'סדנאות וקורסי AI לאוניברסיטאות ולמכללות', 'קורסי AI לאוניברסיטאות ולמכללות']) }
  : { href: '/companies', lead: 'לחברות ולצוותים:', text: pick(['הכשרת AI לארגונים', 'הדרכת בינה מלאכותית לעובדים', 'הכשרת בינה מלאכותית לארגונים']) };
// A second link for hubs that have their own course page or tool.
const course = COURSE_PAGES.find((c) => c.topic === d.topicHub);
const hubLink = course ? { href: course.path, lead: 'רוצים ללמוד את זה לעומק?', text: course.name } : d.topicHub === 'ai-roi' ? { href: '/tools/ai-roi-calculator', lead: 'חשבו בעצמכם:', text: 'מחשבון ROI ל-AI' } : null;
const ctaByOffer: Record<string, string> = {
  '/lectures': 'רוצים הרצאה על זה לארגון שלכם?',
  '/workshops': `רוצים סדנה על ${topic.name} לצוות שלכם?`,
  '/courses': `רוצים קורס ${topic.name} לארגון או לתוכנית שלכם?`,
  '/executive': 'רוצים ליווי אישי כדי ליישם את זה בארגון שלכם?',
};
---
<BaseLayout title={d.title} description={d.description} path={path} type="article" schema={schema} publishedAt={iso(d.publishedAt)} updatedAt={iso(d.updatedAt)}>
  <article>
    <header class="relative overflow-hidden">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container-x relative py-12 md:py-16">
        <Breadcrumbs items={crumbs} />
        <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
        <div>
        <h1 class="h1 max-w-4xl">{d.title}</h1>
        <p class="lead mt-5 max-w-3xl">{d.description}</p>
        <p class="mt-4 text-sm text-muted">
          נכתב על ידי <a href="/team" class="underline underline-offset-2 hover:text-accent">צוות היישום של RealAI</a> · {minutes} דקות קריאה · עודכן לאחרונה: <time datetime={iso(d.updatedAt)}>{d.updatedAt.toLocaleDateString('he-IL', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        </p>
        </div>
        <ArticleCover slug={d.slug} topic={d.topicHub} class="rounded-[4px] border border-line" />
        </div>
      </div>
    </header>
    <div class="container-x grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div>
        {toc.length >= 3 && (
          <nav aria-label="תוכן העניינים" class="card mb-8 max-w-[70ch] p-5">
            <p class="font-bold">בעמוד הזה</p>
            <ol class="mt-3 space-y-1.5 text-sm">
              {toc.map((h) => <li><a href={`#${h.slug}`} class="text-muted hover:text-accent">{h.text}</a></li>)}
            </ol>
          </nav>
        )}
        <div class="prose">
          <slot />
        </div>
      </div>
      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <div class="card p-5">
          <p class="eyebrow">{ctaByOffer[d.relatedOffer]}</p>
          <p class="mt-2 text-sm text-muted">{offer.value}</p>
          <a href={whatsappUrl(`שלום, קראתי את "${d.title}" ואשמח לשמוע על ${offer.name} בנושא ${topic.name}.`)} target="_blank" rel="noopener" class="btn btn-primary mt-4 w-full" data-track="whatsapp_click" data-track-label={`article:${d.slug}`}>דברו איתנו בוואטסאפ</a>
          <a href={d.relatedOffer} class="mt-2 block text-center text-sm text-accent underline underline-offset-2">{offerAnchor(d.relatedOffer, d.slug)}</a>
        </div>
        <div class="card p-5 text-sm">
          <p class="font-bold">בנושא <a href={`/topics/${topic.slug}`} class="text-accent">{topic.name}</a></p>
          {related.length > 0 && <ul class="mt-3 space-y-2 text-muted">{related.slice(0, 3).map((r) => <li><a class="hover:text-accent" href={`/blog/${r.data.slug}`}>{r.data.title}</a></li>)}</ul>}
          <p class="mt-4 border-t border-line pt-3 text-muted">{audienceLink.lead} <a class="text-accent underline underline-offset-2" href={audienceLink.href}>{audienceLink.text}</a></p>
          {hubLink && <p class="mt-2 text-muted">{hubLink.lead} <a class="text-accent underline underline-offset-2" href={hubLink.href}>{hubLink.text}</a></p>}
        </div>
      </aside>
    </div>
  </article>
  {related.length > 3 && (
    <section class="py-14" aria-labelledby="read-next-title">
      <div class="container-x">
        <h2 id="read-next-title" class="h2">מאמרים קשורים</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-3">
          {related.slice(3, 6).map((r) => (
            <li class="card overflow-hidden transition hover:border-ink">
              <a href={`/blog/${r.data.slug}`} class="group block">
                <ArticleCover slug={r.data.slug} topic={r.data.topicHub} />
                <span class="block p-5">
                  <span class="font-bold leading-snug group-hover:text-accent">{r.data.title}</span>
                  <span class="mt-2 block text-sm text-muted">{r.data.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <FAQ items={d.faq} />
  <CTA title={ctaByOffer[d.relatedOffer]} text={`${offer.value} נחזור אליכם תוך יום עסקים.`} whatsappMessage={`שלום, קראתי את "${d.title}" ואשמח לשמוע על ${offer.name}.`} audienceType={offer.audienceType} topic={topic.name} trackLabel={`article-cta:${d.slug}`} />
</BaseLayout>
